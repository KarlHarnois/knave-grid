(use demo/files copy-file create-directories output-path
                source-path)

(export copy-demo-fonts)

(def font-files
  (vec "iosevka-regular.woff2" "iosevka-bold.woff2"
       "iosevka-license.txt" "noto-sans-regular.woff2"
       "noto-sans-bold.woff2" "noto-sans-license.txt"))

(type copy-demo-fonts
  (fn () (result unit string)))

(defn copy-demo-fonts ()
  (try (create-directories (as-str (output-path "fonts"))))
  (copy-font-files 0))

(type copy-font-files
  (fn (usize) (result unit string)))

(defn copy-font-files (index)
  (if (>= index (len font-files))
    (ok (do))
    (let (file-name (at font-files index))
      (try (copy-file (as-str (source-path (as-str (str "fonts/" file-name))))
                      (as-str (output-path (as-str (str "fonts/" file-name))))))
      (recur (+ index 1)))))
