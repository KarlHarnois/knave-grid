(use demo/files copy-file create-directories output-path
                source-path)

(export copy-font-licenses)

(def license-files
  (vec "iosevka-license.txt" "noto-sans-license.txt"))

(type copy-font-licenses
  (fn () (result unit string)))

(defn copy-font-licenses ()
  (try (create-directories (as-str (output-path "fonts"))))
  (copy-license-files 0))

(type copy-license-files
  (fn (usize) (result unit string)))

(defn copy-license-files (index)
  (if (>= index (len license-files))
    (ok (do))
    (let (file-name (at license-files index))
      (try (copy-file (as-str (source-path (as-str (str "fonts/" file-name))))
                      (as-str (output-path (as-str (str "fonts/" file-name))))))
      (recur (+ index 1)))))
