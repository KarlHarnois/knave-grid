(use spec/body-type body-type)
(use spec/type-style type-style)
(use demo/highlight highlighted)
(use demo/html escaped)
(use lib grid-css)
(use spec/body-type baseline-offset-px)
(use spec/layout layout)
(use spec/type-style style-font-size-px style-shift-px)

(export demo-page)

(def replaced
  (rust "{0}.replace({1}, {2})"
    (fn ((ref str) (ref str) (ref str))
      string)))

(defn demo-page (template checked spec-text broken-error)
  (let (spec (:spec checked))
    (-> (replaced template "{{spec}}"
                  (as-str (highlighted spec-text)))
        (as-str)
        (replaced "{{layouts}}" (as-str (layout-rows checked)))
        (as-str)
        (replaced "{{type-styles}}" (as-str (type-style-rows spec)))
        (as-str)
        (replaced "{{baseline-offset}}"
                  (as-str (str (baseline-offset-px (ref (:body-type spec)))
                               "px")))
        (as-str)
        (replaced "{{warnings}}"
                  (as-str (warnings-sentence checked)))
        (as-str)
        (replaced "{{broken-error}}"
                  (as-str (escaped broken-error)))
        (as-str)
        (replaced "{{grid-css}}"
                  (as-str (escaped (as-str (grid-css checked))))))))

(defn type-style-rows (spec)
  (reduce (map (iter (:type-styles spec))
            (fn (style)
              (type-style-row style (:body-type spec))))
          (str)
          (fn (rows row) (str rows row))))

(type type-style-row
  (fn ((ref type-style) (ref body-type))
    string))

(defn type-style-row (style body)
  (str "      <tr><td><code>.type-"
       (:name style)
       "</code></td><td>"
       (:lines style)
       "</td><td>"
       (style-font-size-px style body)
       "px</td><td>"
       (style-shift-px style body)
       "px</td></tr>\n"))

(defn layout-rows (checked)
  (reduce (map (iter (:layouts checked))
            (fn (layout) (layout-row layout)))
          (str)
          (fn (rows row) (str rows row))))

(defn layout-row (layout)
  (let (type-area (:type-area layout))
    (str "      <tr><td>"
         (:name type-area)
         "</td><td>"
         (start-text layout)
         "</td><td>"
         (:width type-area)
         "</td><td>"
         (:column-count type-area)
         "</td><td>"
         (:margin type-area)
         "</td><td>"
         (:head type-area)
         " / "
         (:foot type-area)
         "</td></tr>\n")))

(defn start-text (layout)
  (if (:narrowest? layout)
    (str "any width")
    (str (:min-width-em layout) "em")))

(defn warnings-sentence (checked)
  (if (empty? (:warnings checked))
    (str "The check found no warnings.")
    (str "The check warns: "
         (joined (collect (map (iter (:warnings checked)) warning-text))
                 "; ")
         ".")))

(def joined
  (rust "{0}.join({1})"
    (fn ((vec string) (ref str)) string)))

(defn warning-text (warning) (str warning))
