(use spec/body-type body-type)
(use spec/type-style type-style)

(use lib baseline-offset-px grid-css layout-label length
         length-css style-font-size-px style-shift-px)

(export demo-page)

(def replaced
  (rust "{0}.replace({1}, {2})"
    (fn ((ref str) (ref str) (ref str))
      string)))

(defn demo-page (template checked broken-error)
  (let (spec (:spec checked))
    (-> (replaced template "{{spec}}"
                  (as-str (escaped (as-str (pr-str spec)))))
        (as-str)
        (replaced "{{layouts}}" (as-str (layout-rows checked)))
        (as-str)
        (replaced "{{type-styles}}" (as-str (type-style-rows spec)))
        (as-str)
        (replaced "{{baseline-offset}}"
                  (as-str (str (baseline-offset-px (ref (:body-type spec)))
                               "px")))
        (as-str)
        (replaced "{{lengths}}" (as-str (length-rows)))
        (as-str)
        (replaced "{{warnings}}"
                  (as-str (warnings-sentence checked)))
        (as-str)
        (replaced "{{broken-error}}"
                  (as-str (escaped broken-error)))
        (as-str)
        (replaced "{{grid-css}}"
                  (as-str (escaped (as-str (grid-css checked))))))))

(defn type-style-rows (spec)
  (reduce (map (iter (:type-styles spec))
            (fn (style)
              (type-style-row style (:body-type spec))))
          (str)
          (fn (rows row) (str rows row))))

(type type-style-row
  (fn ((ref type-style) (ref body-type))
    string))

(defn type-style-row (style body)
  (str "      <tr><td><code>.type-"
       (:name style)
       "</code></td><td>"
       (:lines style)
       "</td><td>"
       (style-font-size-px style body)
       "px</td><td>"
       (style-shift-px style body)
       "px</td></tr>\n"))

(defn layout-rows (checked)
  (reduce (map (iter (:layouts checked))
            (fn (layout)
              (layout-row (as-str (layout-label layout))
                          (:type-area layout))))
          (str)
          (fn (rows row) (str rows row))))

(defn layout-row (screen type-area)
  (str "      <tr><td>" screen "</td><td>"
       (:width type-area)
       "</td><td>"
       (:column-count type-area)
       "</td><td>"
       (:margin type-area)
       "</td><td>"
       (:head type-area)
       " / "
       (:foot type-area)
       "</td></tr>\n"))

(defn length-rows ()
  (str (length-row "(length/px 27.0)" (length/px 27.0))
       (length-row "(length/ch 3.0)" (length/ch 3.0))
       (length-row "(length/rem 1.5)" (length/rem 1.5))
       (length-row "(length/lines 2)" (length/lines 2))
       (length-row "(length/columns 2)" (length/columns 2))))

(defn length-row (knave length)
  (str "      <tr><td><code>" knave "</code></td><td><code>"
       (length-css (ref length))
       "</code></td></tr>\n"))

(defn warnings-sentence (checked)
  (if (empty? (:warnings checked))
    (str "The check found no warnings.")
    (str "The check warns: "
         (joined (collect (map (iter (:warnings checked)) warning-text))
                 "; ")
         ".")))

(def escaped
  (rust "{0}.replace('&', \"&amp;\").replace('<', \"&lt;\").replace('>', \"&gt;\")"
    (fn ((ref str)) string)))

(def joined
  (rust "{0}.join({1})"
    (fn ((vec string) (ref str)) string)))

(defn warning-text (warning) (str warning))
