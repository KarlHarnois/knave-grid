(use demo/forms form read-text)

(export pretty-printed)

(def knave-formatted
  (rust "(|| -> Result<String, String> {{
    use std::io::Write;
    let mut child = std::process::Command::new(\"knave\")
        .args([\"fmt\", \"-\"])
        .stdin(std::process::Stdio::piped())
        .stdout(std::process::Stdio::piped())
        .stderr(std::process::Stdio::piped())
        .spawn()
        .map_err(|error| format!(\"cannot run knave fmt: {{error}}\"))?;
    child.stdin.take().unwrap().write_all({0}.as_bytes()).map_err(|error| error.to_string())?;
    let output = child.wait_with_output().map_err(|error| error.to_string())?;
    if output.status.success() {{
        Ok(String::from_utf8_lossy(&output.stdout).trim_end().to_string())
    }} else {{
        Err(String::from_utf8_lossy(&output.stderr).to_string())
    }}
}})()"
    (fn ((ref str)) (result string string))))

(type pretty-printed
  (fn ((ref str)) (result string string)))

(defn pretty-printed (text)
  (let (fields (flat-text (ref (without-absent-fields (read-text text)))))
    (knave-formatted (as-str fields))))

(type without-absent-fields (fn (form) form))

(defn without-absent-fields (form)
  (match form
    ((group items) (form/group (present-items items 0 (vec))))
    ((atom text) (form/atom text))))

(type present-items
  (fn ((vec form) usize (vec form))
    (vec form)))

(defn present-items (items index kept)
  (cond
    ((>= index (len items)) kept)
    ((absent-field? (ref items) index)
     (recur items (+ index 2) kept))
    (else (do
            (push! kept
                   (without-absent-fields (clone (at items index))))
            (recur items (+ index 1) kept)))))

(type absent-field?
  (fn ((ref (vec form)) usize) bool))

(defn absent-field? (items index)
  (and (< (+ index 1) (len items))
       (keyword? (at items index))
       (= (flat-text (at items (+ index 1)))
          "none")))

(type keyword? (fn ((ref form)) bool))

(defn keyword? (form)
  (match form
    ((atom text) (starts-with? (as-str text) ":"))
    ((group _) false)))

(def starts-with?
  (rust "{0}.starts_with({1})"
    (fn ((ref str) (ref str)) bool)))

(type flat-text
  (fn ((ref form)) string))

(defn flat-text (form)
  (match form
    ((atom text) (clone text))
    ((group items)
     (str "("
          (joined (collect (map (iter items) flat-text))
                  " ")
          ")"))))

(def joined
  (rust "{0}.join({1})"
    (fn ((vec string) (ref str)) string)))
