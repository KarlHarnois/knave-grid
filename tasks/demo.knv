(use demo/files copy-file create-directories error-text
                output-directory output-path source-path
                write-output)

(use demo/fonts demo-font-family)
(use demo/page demo-page)
(use demo/pretty pretty-printed)

(use lib checked-grid defgrid font-family grid-css
         overlay-css overlay-javascript)

(def wide-column-count 4)

(def column-count-that-does-not-fit 7)

(def page-files (vec "style.css" "font-toggle.js"))

(deftask demo ()
  "Builds a page that shows the grid into target/demo/."
  (try (create-directories output-directory))
  (let (monospace (try (demo-font-family "Iosevka" "iosevka"))
        proportional (try (demo-font-family "Noto Sans" "noto-sans"))
        monospace-grid (try (checked-demo-grid (clone monospace)))
        proportional-grid (try (checked-demo-grid proportional))
        template (try (map-err (slurp (as-str (source-path "index.html")))
                               error-text)))
    (try (write-output "grid-monospace.css"
                       (as-str (grid-css (ref monospace-grid)))))
    (try (write-output "grid-proportional.css"
                       (as-str (grid-css (ref proportional-grid)))))
    (try (write-output "grid-overlay.css" overlay-css))
    (try (write-output "grid-overlay.js" overlay-javascript))
    (try (copy-page-files 0))
    (write-output "index.html"
                  (as-str (demo-page (as-str template)
                                     (ref monospace-grid)
                                     (as-str (try (pretty-printed
                                                    (as-str (pr-str (:spec monospace-grid))))))
                                     (as-str (broken-spec-error monospace)))))))

(defn copy-page-files (index)
  (if (>= index (len page-files))
    (ok (do))
    (let (file-name (at page-files index))
      (try (copy-file (as-str (source-path file-name))
                      (as-str (output-path file-name))))
      (recur (+ index 1)))))

(type checked-demo-grid
  (fn (font-family) (result checked-grid string)))

(defn checked-demo-grid (family)
  (map-err (demo-grid family wide-column-count) error-text))

(defgrid demo-grid
         (family wide-columns)
         (body family :size 18 :line-height 1.5)
         (type-areas (narrow :width 19 :column-count 1 :head 1)
                     (medium :width 19 :column-count 2)
                     (wide :width 39
                           :column-count wide-columns
                           :margin 2
                           :foot 3))
         (type-styles (display :lines 2)
                      (headline :lines 3)
                      (title :lines 4)))

(defn broken-spec-error (family)
  (match (demo-grid family column-count-that-does-not-fit)
    ((ok _) (str "no error"))
    ((err error) (str error))))
