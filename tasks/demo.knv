(use demo/files copy-file create-directories error-text
                output-directory output-path source-path
                write-output)

(use demo/fonts copy-demo-fonts)
(use demo/page demo-page)
(use demo/grid demo-grid)

(use lib checked-grid defgrid grid-css overlay-css
         overlay-javascript)

(def grid-source-path "tasks/demo/grid.knv")

(def page-files (vec "style.css" "font-toggle.js"))

(deftask demo ()
  "Builds a page that shows the grid into target/demo/."
  (try (create-directories output-directory))
  (try (copy-demo-fonts))
  (let (monospace-grid (try (checked-demo-grid false))
        proportional-grid (try (checked-demo-grid true))
        template (try (map-err (slurp (as-str (source-path "index.html")))
                               error-text)))
    (try (write-output "grid-monospace.css"
                       (as-str (grid-css (ref monospace-grid)))))
    (try (write-output "grid-proportional.css"
                       (as-str (grid-css (ref proportional-grid)))))
    (try (write-output "grid-overlay.css" overlay-css))
    (try (write-output "grid-overlay.js" overlay-javascript))
    (try (copy-page-files 0))
    (write-output "index.html"
                  (as-str (demo-page (as-str template)
                                     (ref monospace-grid)
                                     (as-str (try (demo-grid-source)))
                                     (as-str (broken-spec-error)))))))

(defn copy-page-files (index)
  (if (>= index (len page-files))
    (ok (do))
    (let (file-name (at page-files index))
      (try (copy-file (as-str (source-path file-name))
                      (as-str (output-path file-name))))
      (recur (+ index 1)))))

(type checked-demo-grid
  (fn (bool) (result checked-grid string)))

(defn checked-demo-grid (proportional?)
  (map-err (demo-grid proportional?) error-text))

(defgrid seven-column-grid
         ()
         (fonts :from "demo/fonts"
                :at "/fonts"
                (iosevka "Iosevka" (regular "iosevka-regular.woff2")))
         (body iosevka :size 18 :line-height 1.5)
         (type-areas (narrow :width 19 :column-count 1)
                     (wide :width 39 :column-count 7 :margin 2)))

(defn demo-grid-source ()
  (let (source (try (map-err (slurp grid-source-path) error-text)))
    (ok (from-defgrid (as-str source)))))

(def from-defgrid
  (rust "{0}[{0}.find(\"\\n(defgrid\").map_or(0, |start| start + 1)..].trim_end().to_string()"
    (fn ((ref str)) string)))

(defn broken-spec-error ()
  (match (seven-column-grid)
    ((ok _) (str "no error"))
    ((err error) (str error))))
