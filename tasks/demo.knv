(use demo/files copy-file create-directories error-text
                output-directory output-path source-path
                write-output)

(use demo/fonts demo-family-faces)
(use demo/page demo-page)

(use lib ->body-type ->breakpoint ->grid-spec ->type-area
         ->type-style check-grid checked-grid font-face-css
         font-metrics grid-css overlay-css
         overlay-javascript)

(def body-font-size-px 18.0)

(def body-line-height 1.5)

(def narrow-width 19)

(def medium-min-width-em 36.0)

(def medium-column-count 2)

(def wide-min-width-em 73.0)

(def wide-width 39)

(def wide-column-count 4)

(def column-count-that-does-not-fit 7)

(def measure-ch 66)

(def page-files (vec "style.css" "font-toggle.js"))

(deftask demo ()
  "Builds a page that shows the grid into target/demo/."
  (try (create-directories output-directory))
  (let (monospace (try (demo-family-faces "Iosevka" "iosevka"))
        proportional (try (demo-family-faces "Noto Sans" "noto-sans"))
        monospace-metrics (deref (:metrics (at monospace 0)))
        monospace-grid (try (checked-demo-grid monospace-metrics))
        proportional-grid (try (checked-demo-grid (deref (:metrics (at proportional
                                                                       0)))))
        faces (all-faces monospace proportional)
        template (try (map-err (slurp (as-str (source-path "index.html")))
                               error-text)))
    (try (write-output "fonts.css"
                       (as-str (font-face-css (ref faces)))))
    (try (write-output "grid-monospace.css"
                       (as-str (grid-css (ref monospace-grid)))))
    (try (write-output "grid-proportional.css"
                       (as-str (grid-css (ref proportional-grid)))))
    (try (write-output "grid-overlay.css" overlay-css))
    (try (write-output "grid-overlay.js" overlay-javascript))
    (try (copy-page-files 0))
    (write-output "index.html"
                  (as-str (demo-page (as-str template)
                                     (ref monospace-grid)
                                     (ref faces)
                                     (as-str (broken-spec-error
                                               monospace-metrics)))))))

(defn all-faces (monospace proportional)
  (let (faces monospace)
    (for-each (iter proportional)
      (fn (face) (push! faces (clone face))))
    faces))

(defn copy-page-files (index)
  (if (>= index (len page-files))
    (ok (do))
    (let (file-name (at page-files index))
      (try (copy-file (as-str (source-path file-name))
                      (as-str (output-path file-name))))
      (recur (+ index 1)))))

(type checked-demo-grid
  (fn (font-metrics) (result checked-grid string)))

(defn checked-demo-grid (metrics)
  (map-err (check-grid (demo-spec wide-column-count metrics))
           error-text))

(defn demo-spec (wide-columns metrics)
  (->grid-spec
    :body-type (->body-type body-font-size-px body-line-height metrics)
    :type-area (->type-area :width narrow-width :column-count 1 :head 1)
    :measure-ch measure-ch
    :breakpoints (vec (->breakpoint medium-min-width-em
                                    (->type-area
                                      :width narrow-width
                                      :column-count medium-column-count))
                      (->breakpoint wide-min-width-em
                                    (->type-area :width wide-width
                                                 :column-count wide-columns
                                                 :margin 2
                                                 :foot 3)))
    :type-styles (vec (->type-style :name (str "display") :lines 2)
                      (->type-style :name (str "headline") :lines 3)
                      (->type-style :name (str "title") :lines 4))))

(defn broken-spec-error (metrics)
  (match (check-grid (demo-spec column-count-that-does-not-fit metrics))
    ((ok _) (str "no error"))
    ((err error) (str error))))
