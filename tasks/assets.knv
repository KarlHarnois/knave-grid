(def write-file
  (rust "std::fs::write({0}, {1})"
    (fn ((ref str) (ref str))
      (result unit io-error))))

(def escaped
  (rust "{0}.replace('\\\\', \"\\\\\\\\\").replace('\"', \"\\\\\\\"\")"
    (fn ((ref str)) string)))

(def generated-module "src/overlay.knv")

(deftask embed-assets ()
  "Writes assets/overlay.css and assets/overlay.js into src/overlay.knv."
  (let (css (try (slurp "assets/overlay.css"))
        javascript (try (slurp "assets/overlay.js")))
    (write-file generated-module
                (as-str (str "; Generated by `knave task embed-assets` from assets/. Edit those files instead.\n\n"
                             "(export overlay-css overlay-javascript)\n\n"
                             "(def overlay-css\n  \""
                             (escaped (as-str css))
                             "\")\n\n"
                             "(def overlay-javascript\n  \""
                             (escaped (as-str javascript))
                             "\")\n")))))
