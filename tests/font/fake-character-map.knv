(use font/fake-bytes joined-bytes u16-bytes u32-bytes)

(export cmap-table)

(def zero-code-point 48)

(def last-code-point 65535)

(defn cmap-table ()
  (joined-bytes (ref (vec (u16-bytes 0)
                          (u16-bytes 1)
                          (u16-bytes 3)
                          (u16-bytes 1)
                          (u32-bytes 12)
                          (format-4-subtable)))))

(defn format-4-subtable ()
  (let (zero-glyph-delta (- 1 zero-code-point))
    (joined-bytes (ref (vec (u16-bytes 4)
                            (u16-bytes 32)
                            (u16-bytes 0)
                            (u16-bytes 4)
                            (u16-bytes 4)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes zero-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes 0)
                            (u16-bytes zero-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes zero-glyph-delta)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes 0))))))
