(use font/fake-bytes joined-bytes u16-bytes u32-bytes)

(export cmap-table)

(def last-code-point 65535)

(defn cmap-table (mapped-code-point)
  (joined-bytes (ref (vec (u16-bytes 0)
                          (u16-bytes 1)
                          (u16-bytes 3)
                          (u16-bytes 1)
                          (u32-bytes 12)
                          (format-4-subtable mapped-code-point)))))

(defn format-4-subtable (mapped-code-point)
  (let (glyph-delta (- 1 mapped-code-point))
    (joined-bytes (ref (vec (u16-bytes 4)
                            (u16-bytes 32)
                            (u16-bytes 0)
                            (u16-bytes 4)
                            (u16-bytes 4)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes mapped-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes 0)
                            (u16-bytes mapped-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes glyph-delta)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes 0))))))
