(use font/fake-fonts ->fake-font truetype-bytes woff2-bytes)

(use font/metrics ->font-metrics parse-font-metrics
                  read-font-metrics)

(defn font-asking-for-typo-metrics ()
  (->fake-font :units-per-em 2000
               :hhea-ascender 1700
               :hhea-descender -500
               :typo-ascender 1600
               :typo-descender -400
               :cap-height 1400
               :uses-typo-metrics? true))

(defn font-without-the-typo-flag ()
  (->fake-font :units-per-em 1000
               :hhea-ascender 900
               :hhea-descender -300
               :typo-ascender 800
               :typo-descender -200
               :uses-typo-metrics? false))

(deftest reads-hhea-metrics-even-when-the-font-asks-for-typo-metrics
  (assert (= (unwrap-ok (parse-font-metrics (ref (woff2-bytes (font-asking-for-typo-metrics)))))
             (->font-metrics 2000 1700 500 500 1400 true))))

(deftest reads-hhea-metrics-from-a-truetype-font
  (assert (= (unwrap-ok (parse-font-metrics (ref (truetype-bytes (font-without-the-typo-flag)))))
             (->font-metrics 1000 900 300 500 700 true))))

(deftest reads-the-same-metrics-from-woff2-and-truetype
  (assert (= (parse-font-metrics (ref (woff2-bytes (font-without-the-typo-flag))))
             (parse-font-metrics (ref (truetype-bytes (font-without-the-typo-flag)))))))

(defn zero-width-of (bytes)
  (:zero-width (unwrap-ok (parse-font-metrics (ref bytes)))))

(defn font-with-a-narrow-zero (transformed-hmtx?)
  (->fake-font :units-per-em 1000
               :hhea-ascender 900
               :hhea-descender -300
               :typo-ascender 800
               :typo-descender -200
               :uses-typo-metrics? false
               :zero-width 450
               :transformed-hmtx? transformed-hmtx?))

(deftest reads-the-width-of-the-zero-glyph-from-a-truetype-font
  (assert (= (zero-width-of (truetype-bytes (font-with-a-narrow-zero false)))
             450)))

(deftest reads-the-width-of-the-zero-glyph-from-a-transformed-woff2-width-table
  (assert (= (zero-width-of (woff2-bytes (font-with-a-narrow-zero true)))
             450)))

(deftest rejects-a-file-that-is-not-a-font
  (assert (= (str (unwrap-err (read-font-metrics "tests/fixtures/grid.css")))
             "not a usable font: not a TrueType, OpenType or WOFF2 font")))

(deftest names-a-font-file-it-cannot-read
  (assert (= (str (unwrap-err (read-font-metrics
                                "tests/fixtures/missing.woff2")))
             "cannot read tests/fixtures/missing.woff2: No such file or directory (os error 2)")))

(deftest refuses-a-font-without-a-cap-height
  (let (font (->fake-font :units-per-em 1000
                          :hhea-ascender 900
                          :hhea-descender -300
                          :typo-ascender 800
                          :typo-descender -200
                          :uses-typo-metrics? false
                          :os2-version 1))
    (assert (= (str (unwrap-err (parse-font-metrics (ref (truetype-bytes
                                                           font)))))
               "not a usable font: the font's OS/2 table is older than version 2, so it has no cap height"))))

(deftest reads-a-proportional-font-as-not-monospace
  (let (font (->fake-font :units-per-em 1000
                          :hhea-ascender 900
                          :hhea-descender -300
                          :typo-ascender 800
                          :typo-descender -200
                          :uses-typo-metrics? false
                          :fixed-pitch? false))
    (assert (not (:monospace? (unwrap-ok (parse-font-metrics (ref (woff2-bytes font)))))))))
