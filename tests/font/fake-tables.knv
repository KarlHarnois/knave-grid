(use font/fake-character-map cmap-table)

(use font/fake-bytes byte i16-bytes joined-bytes u16-bytes
                     u32-bytes zeros)

(export ->fake-font ->fake-table fake-font fake-table
        hmtx-table truetype-tables woff2-tables)

(defstruct fake-font
  :units-per-em i64
  :hhea-ascender i64
  :hhea-descender i64
  :typo-ascender i64
  :typo-descender i64
  :uses-typo-metrics? bool
  :zero-width i64
  :transformed-hmtx? bool
  :cap-height i64
  :os2-version i64
  :fixed-pitch? bool
  (defaults :zero-width 500
            :transformed-hmtx? false
            :cap-height 700
            :os2-version 4
            :fixed-pitch? true))

(defstruct fake-table
  :tag string
  :woff2-index i64
  :bytes (vec u8))

(def use-typo-metrics-flag 128)

(def notdef-width 600)

(def hmtx-lsb-omitted-flags 3)

(type truetype-tables
  (fn (fake-font) (vec fake-table)))

(defn truetype-tables (font)
  (tables-with-hmtx font (hmtx-table font)))

(type woff2-tables
  (fn (fake-font) (vec fake-table)))

(defn woff2-tables (font)
  (tables-with-hmtx font
                    (if (:transformed-hmtx? font)
                      (transformed-hmtx-table font)
                      (hmtx-table font))))

(type tables-with-hmtx
  (fn (fake-font (vec u8))
    (vec fake-table)))

(defn tables-with-hmtx (font hmtx)
  (vec (->fake-table (str "cmap") 0 (cmap-table))
       (->fake-table (str "head") 1 (head-table font))
       (->fake-table (str "hhea") 2 (hhea-table font))
       (->fake-table (str "hmtx") 3 hmtx)
       (->fake-table (str "OS/2") 6 (os2-table font))
       (->fake-table (str "post") 7 (post-table font))))

(type head-table
  (fn (fake-font) (vec u8)))

(defn head-table (font)
  (joined-bytes (ref (vec (zeros 18)
                          (u16-bytes (:units-per-em font))
                          (zeros 34)))))

(type hhea-table
  (fn (fake-font) (vec u8)))

(defn hhea-table (font)
  (joined-bytes (ref (vec (zeros 4)
                          (i16-bytes (:hhea-ascender font))
                          (i16-bytes (:hhea-descender font))
                          (zeros 26)
                          (u16-bytes 2)))))

(type hmtx-table
  (fn (fake-font) (vec u8)))

(defn hmtx-table (font)
  (joined-bytes (ref (vec (u16-bytes notdef-width)
                          (i16-bytes 0)
                          (u16-bytes (:zero-width font))
                          (i16-bytes 0)))))

(type transformed-hmtx-table
  (fn (fake-font) (vec u8)))

(defn transformed-hmtx-table (font)
  (joined-bytes (ref (vec (byte hmtx-lsb-omitted-flags)
                          (u16-bytes notdef-width)
                          (u16-bytes (:zero-width font))))))

(type os2-table
  (fn (fake-font) (vec u8)))

(defn os2-table (font)
  (joined-bytes (ref (vec (u16-bytes (:os2-version font))
                          (zeros 60)
                          (u16-bytes (selection-flags font))
                          (zeros 4)
                          (i16-bytes (:typo-ascender font))
                          (i16-bytes (:typo-descender font))
                          (zeros 16)
                          (i16-bytes (:cap-height font))
                          (zeros 6)))))

(defn selection-flags (font)
  (if (:uses-typo-metrics? font) use-typo-metrics-flag 0))

(type post-table
  (fn (fake-font) (vec u8)))

(defn post-table (font)
  (joined-bytes (ref (vec (zeros 12)
                          (u32-bytes (if (:fixed-pitch? font) 1 0))
                          (zeros 16)))))
