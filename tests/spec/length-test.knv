(use lib length length-css)

(defn css-of (length)
  (length-css (ref length)))

(deftest writes-an-absolute-length-with-its-unit
  (assert (= (vec (css-of (length/px 27.0))
                  (css-of (length/ch 3.0))
                  (css-of (length/rem 1.125)))
             (vec (str "27px")
                  (str "3ch")
                  (str "1.125rem")))))

(deftest writes-lines-in-root-line-heights
  (assert (= (css-of (length/lines 2)) "2rlh")))

(deftest writes-one-column-as-the-column-width
  (assert (= (css-of (length/columns 1)) "var(--column)")))

(deftest writes-columns-as-their-widths-with-the-gutters-between
  (assert (= (css-of (length/columns 3))
             "calc(3 * var(--column) + 2 * var(--gutter))")))
