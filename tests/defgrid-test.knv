(use font/fake-font-files write-fake-font-files)
(use css/grid grid-css)
(use lib defgrid write-grid)
(use strings contains?)

(defgrid site-grid
         ()
         (fonts :from "target/fake-fonts"
                (fake-sans "Fake Sans"
                           (regular "fake-sans-regular.ttf")
                           (bold "fake-sans-bold.ttf")))
         (body fake-sans :size 18 :line-height 1.5)
         (type-areas (narrow :width 19 :column-count 1 :head 1)
                     (wide :width 39 :column-count 4 :margin 2))
         (type-styles (headline :lines 3 :weight bold)))

(defgrid plain-grid
         ()
         (fonts :from "target/fake-fonts"
                (fake-sans "Fake Sans" (regular "fake-sans-regular.ttf")))
         (body fake-sans :size 18 :line-height 1.5)
         (type-areas (page :width 19 :column-count 1)))

(defgrid light-grid
         ()
         (fonts :from "target/fake-fonts"
                (fake-sans "Fake Sans" (regular "fake-sans-regular.ttf")))
         (body fake-sans :size 18 :line-height 1.5 :weight light)
         (type-areas (page :width 19 :column-count 1)))

(defgrid missing-font-grid
         ()
         (fonts :from "target/fake-fonts"
                (fake-sans "Fake Sans" (regular "missing.ttf")))
         (body fake-sans :size 18 :line-height 1.5)
         (type-areas (page :width 19 :column-count 1)))

(defgrid broken-grid
         ()
         (fonts :from "target/fake-fonts"
                (fake-sans "Fake Sans" (regular "fake-sans-regular.ttf")))
         (body fake-sans :size 18 :line-height 1.5)
         (type-areas (narrow :width 19 :column-count 1)
                     (wide :width 39 :column-count 7)))

(defn error-text (grid)
  (str (unwrap-err grid)))

(deftest builds-and-checks-a-grid-from-its-parts
  (write-fake-font-files)
  (let (checked (unwrap-ok (site-grid)))
    (assert (= (pr-str (:spec checked))
               "(->grid-spec :body-type (->body-type :size 18.0 :line-height 1.5 :font-family (font-family \"Fake Sans\") :weight \"regular\") :type-areas (vec (->type-area :name \"narrow\" :width 19 :gutter 1 :column-count 1 :margin 1 :head 1 :foot 2 :measure-columns none) (->type-area :name \"wide\" :width 39 :gutter 1 :column-count 4 :margin 2 :head 2 :foot 2 :measure-columns none)) :type-styles (vec (->type-style :name \"headline\" :lines 3 :size none :font-family none :weight (some \"bold\") :baseline-line none)))"))))

(deftest leaves-out-the-type-styles
  (write-fake-font-files)
  (assert (ok? (plain-grid))))

(deftest rejects-a-body-weight-the-family-lacks
  (write-fake-font-files)
  (assert (= (error-text (light-grid))
             "the body uses Fake Sans at weight light, but the family has no light file")))

(deftest returns-the-font-error
  (assert (= (error-text (missing-font-grid))
             "cannot read target/fake-fonts/missing.ttf: No such file or directory (os error 2)")))

(deftest returns-the-check-error
  (write-fake-font-files)
  (assert (= (error-text (broken-grid))
             "in the wide type area, from 69.1875em, 39 squares with a gutter of 1 square do not fit 7 columns; the column counts that fit are 1, 2, 4, 5, 8, 10, 20")))

(deftest writes-each-weight-the-grid-uses
  (write-fake-font-files)
  (let (css (grid-css (ref (unwrap-ok (site-grid)))))
    (assert (contains?
              (as-str css)
              "url(\"fonts/fake-sans-bold.ttf\");\n  font-weight: 700;"))
    (assert (contains? (as-str css)
                       ".type-headline {\n  font-weight: 700;"))))

(def file-exists?
  (rust "std::path::Path::new({0}).is_file()"
    (fn ((ref str)) bool)))

(deftest writes-the-stylesheet-with-its-fonts-beside-it
  (write-fake-font-files)
  (assert (ok? (write-grid (ref (unwrap-ok (site-grid)))
                           "target/written-grid/grid.css")))
  (assert (file-exists? "target/written-grid/grid.css"))
  (assert (file-exists? "target/written-grid/fonts/fake-sans-regular.ttf"))
  (assert (file-exists? "target/written-grid/fonts/fake-sans-bold.ttf")))
