(use spec/fake-type body-type-at)
(use lib ->grid-spec ->type-area ->type-style check-grid)

(defn type-style-error (style)
  (str (unwrap-err (check-grid (->grid-spec :body-type (body-type-at 18.0 1.5)
                                            :type-area (->type-area
                                                         :width 19
                                                         :column-count 1)
                                            :measure-ch 50
                                            :type-styles (vec style))))))

(deftest rejects-a-type-style-without-lines
  (assert (= (type-style-error (->type-style :name (str "empty") :lines 0))
             "the type style empty needs at least one line")))

(deftest rejects-type-too-tall-for-its-lines
  (assert (= (type-style-error (->type-style :name (str "caption")
                                             :lines 1
                                             :font-size-px (some 30.0)))
             "the type style caption sets 30px type, whose glyphs are 30px tall, in 27px of lines")))

(deftest rejects-a-baseline-line-outside-the-style
  (assert (= (type-style-error (->type-style :name (str "title")
                                             :lines 2
                                             :baseline-line (some 3)))
             "the type style title puts its baseline on line 3, but it has lines 1 to 2")))
