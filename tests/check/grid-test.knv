(use spec/fake-type body-type-at body-type-with fake-family)
(use spec/type-style ->type-style)
(use font/metrics ->font-metrics)
(use check/grid check-grid)
(use spec/grid-spec ->grid-spec)
(use spec/type-area ->type-area)

(defn checked-spec (column-count)
  (check-grid (->grid-spec :body-type (body-type-at 18.0 1.5)
                           :type-areas (vec (->type-area
                                              :name (str "page")
                                              :width 39
                                              :column-count column-count)))))

(defn error-text (column-count)
  (str (unwrap-err (checked-spec column-count))))

(deftest rejects-a-type-area-that-does-not-fit
  (assert (= (error-text 7)
             "in the page type area, 39 squares with a gutter of 1 square do not fit 7 columns; the column counts that fit are 1, 2, 4, 5, 8, 10, 20")))

(deftest accepts-a-monospace-font-whose-square-is-whole-characters
  (let (body (body-type-with 18.0 1.5
                             (->font-metrics 1000 800 200 (some 500) 700 true)))
    (assert (ok? (check-grid (->grid-spec
                               :body-type body
                               :type-areas (vec (->type-area
                                                  :name (str "page")
                                                  :width 39
                                                  :column-count 4))))))))

(deftest rejects-a-monospace-font-whose-square-splits-a-character
  (let (body (body-type-with 20.0 1.4
                             (->font-metrics 1000 800 200 (some 500) 700 true)))
    (assert (= (str (unwrap-err (check-grid
                                  (->grid-spec
                                    :body-type body
                                    :type-areas (vec (->type-area
                                                       :name (str "page")
                                                       :width 39
                                                       :column-count 4))))))
               "the body font is monospace, but a square of 28px is 2.8 characters of 10px; choose a line-height that makes it a whole number"))))

(deftest rejects-a-body-font-without-a-zero
  (let (body (body-type-with 18.0 1.5
                             (->font-metrics 1000 800 200 none 700 false)))
    (assert (= (str (unwrap-err (check-grid
                                  (->grid-spec
                                    :body-type body
                                    :type-areas (vec (->type-area
                                                       :name (str "page")
                                                       :width 19
                                                       :column-count 1))))))
               "the body font Fake Sans has no glyph for 0, so the grid cannot measure its characters; give the body a full font file"))))

(deftest accepts-a-subset-font-for-a-type-style
  (let (subset (fake-family "Fake Light" "fake-light.woff2"
                            (->font-metrics 1000 800 200 none 700 false)))
    (assert (ok? (check-grid (->grid-spec
                               :body-type (body-type-at 18.0 1.5)
                               :type-areas (vec (->type-area :name (str "page")
                                                             :width 19
                                                             :column-count 1))
                               :type-styles (vec (->type-style :name (str "wordmark")
                                                               :lines 4
                                                               :size (some 72.0)
                                                               :font-family (some
                                                                              subset)))))))))
