(use spec/fake-type body-type-at)
(use lib ->grid-spec ->type-area check-grid grid-css)

(def contains-text?
  (rust "{0}.contains({1})"
    (fn ((ref str) (ref str)) bool)))

(defn spec-with (type-areas)
  (->grid-spec :body-type (body-type-at 18.0 1.5)
               :type-areas type-areas))

(defn type-area-error (type-areas)
  (str (unwrap-err (check-grid (spec-with type-areas)))))

(defn narrow (column-count)
  (->type-area :width 19 :column-count column-count))

(defn wide (column-count margin)
  (->type-area :width 39
               :column-count column-count
               :margin margin))

(deftest accepts-type-areas-from-narrowest-to-widest
  (let (spec (spec-with (vec (narrow 1) (narrow 2) (wide 4 1))))
    (assert (empty? (:warnings (unwrap-ok (check-grid spec)))))))

(deftest starts-a-type-area-where-it-and-its-margins-fit
  (let (checked (unwrap-ok (check-grid (spec-with (vec (narrow 1)
                                                       (wide 4 2))))))
    (assert (contains-text? (as-str (grid-css (ref checked)))
                            "@media (min-width: 72.5625em)"))))

(deftest rejects-a-grid-without-type-areas
  (assert (= (type-area-error (vec))
             "a grid spec needs at least one type area")))

(deftest rejects-a-wider-type-area-that-does-not-fit
  (assert (= (type-area-error (vec (narrow 1) (wide 7 1)))
             "from 69.1875em, a type area of 39 squares with a gutter of 1 square does not fit 7 columns; the column counts that fit are 1, 2, 4, 5, 8, 10, 20")))

(deftest rejects-type-areas-out-of-order
  (assert (= (type-area-error (vec (narrow 1) (wide 4 1) (narrow 2)))
             "the type area of 19 squares with margins of 1 square needs 35.4375em, no more than the one before it, which needs 69.1875em; list type areas from narrowest to widest")))

(deftest rejects-a-page-margin-of-no-squares
  (assert (= (type-area-error
               (vec (narrow 1)
                    (->type-area :width 39 :column-count 4 :foot 0)))
             "the foot margin is 0 squares, but a page edge needs at least one square to its nearest baseline")))
