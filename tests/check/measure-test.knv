(use spec/fake-type body-type-at)
(use spec/measure measure-columns)
(use check/grid check-grid)
(use spec/grid-spec ->grid-spec)
(use spec/type-area ->type-area)

(defn four-columns (measure-columns)
  (->type-area :name (str "page")
               :width 39
               :column-count 4
               :measure-columns measure-columns))

(defn two-columns-of-42-characters ()
  (->type-area :name (str "page") :width 29 :column-count 2))

(defn spec-with (type-area)
  (->grid-spec :body-type (body-type-at 18.0 1.5)
               :type-areas (vec type-area)))

(defn warning-texts (type-area)
  (collect (map (iter (:warnings (unwrap-ok (check-grid (spec-with
                                                          type-area)))))
                (fn (warning) (str warning)))))

(defn columns-of (type-area)
  (measure-columns (ref type-area)
                   (ref (body-type-at 18.0 1.5))))

(deftest spans-the-widest-whole-columns-within-66-characters
  (assert (= (columns-of (four-columns none)) 2)))

(deftest spans-at-least-one-column
  (assert (= (columns-of
               (->type-area :name (str "page") :width 39 :column-count 1))
             1)))

(deftest uses-the-span-a-type-area-names
  (assert (= (columns-of (four-columns (some 3)))
             3)))

(deftest accepts-a-span-within-45-to-75-characters
  (assert (empty? (warning-texts (four-columns none)))))

(deftest warns-about-a-span-wider-than-75-characters
  (assert (= (warning-texts (four-columns (some 4)))
             (vec (str "in the page type area, the measure spans 4 columns, 117 characters, outside 45 to 75")))))

(deftest warns-about-a-span-narrower-than-45-characters
  (assert (= (warning-texts (two-columns-of-42-characters))
             (vec (str "in the page type area, the measure spans 1 column, 42 characters, outside 45 to 75")))))

(deftest rejects-a-span-wider-than-the-type-area
  (assert (= (str (unwrap-err (check-grid (spec-with (four-columns (some 5))))))
             "in the page type area, the measure spans 5 columns, but the type area has columns 1 to 4")))
