(use lib ->body-type ->grid-spec ->type-area check-grid
         grid-css)

(defn four-column-grid ()
  (unwrap-ok (check-grid (->grid-spec :body-type (->body-type 20.0 1.4)
                                      :type-area (->type-area 100 4 4)
                                      :measure-ch 60))))

(deftest writes-the-root-and-grid-rules-of-a-spec
  (assert (= (grid-css (ref (four-column-grid)))
             (unwrap-ok (slurp "tests/fixtures/grid.css")))))
