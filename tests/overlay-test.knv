(use lib overlay-css overlay-javascript)
(use strings contains?)

(def stale-assets-help "run `knave task embed-assets`")

(deftest embeds-the-overlay-css-asset
  (assert (= overlay-css (unwrap-ok (slurp "assets/overlay.css")))
          stale-assets-help))

(deftest embeds-the-overlay-javascript-asset
  (assert (= overlay-javascript
             (unwrap-ok (slurp "assets/overlay.js")))
          stale-assets-help))

(deftest reads-the-grid-query-parameter
  (assert (contains? overlay-javascript "\"grid\"")))

(deftest toggles-on-the-g-key
  (assert (contains? overlay-javascript "\"g\"")))

(deftest toggles-on-a-click-of-a-toggle-button
  (assert (contains? overlay-javascript "\"[data-grid-toggle]\"")))

(deftest toggles-the-grid-overlay-class
  (assert (contains? overlay-javascript "\"grid-overlay\"")))

(deftest toggles-the-guides-with-their-own-class-and-buttons
  (assert (and (contains? overlay-javascript "\"grid-guides\"")
               (contains? overlay-javascript "\"guides\"")
               (contains? overlay-javascript
                          "\"[data-grid-guides-toggle]\""))))

(deftest draws-the-guides-on-their-own-layer
  (assert (contains? overlay-css ":root.grid-guides body::before {")))
