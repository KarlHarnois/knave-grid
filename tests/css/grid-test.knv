(use spec/fake-type body-type-at)
(use font/metrics ->font-metrics)
(use spec/fake-type fake-family)
(use check/grid check-grid)
(use css/grid grid-css)
(use spec/grid-spec ->grid-spec)
(use spec/type-area ->type-area)
(use spec/type-style ->type-style)

(defn fake-serif-family ()
  (fake-family "Fake Serif" "fake-serif.woff2"
               (->font-metrics 1000 700 300 (some 500) 700 false)))

(defn type-styles ()
  (vec (->type-style :name (str "title") :lines 3)
       (->type-style :name (str "lead") :lines 2 :size (some 30.0))
       (->type-style :name (str "quote")
                     :lines 2
                     :font-family (some (fake-serif-family)))))

(defn four-column-grid ()
  (unwrap-ok (check-grid (->grid-spec
                           :body-type (body-type-at 20.0 1.4)
                           :type-areas (vec (->type-area :name (str "narrow")
                                                         :width 23
                                                         :column-count 4
                                                         :margin 2
                                                         :head 3)
                                            (->type-area :name (str "wide")
                                                         :width 35
                                                         :column-count 4
                                                         :margin 3
                                                         :head 4
                                                         :foot 3))
                           :type-styles (type-styles)))))

(deftest writes-the-root-media-grid-and-type-style-rules-of-a-spec
  (assert (= (grid-css (ref (four-column-grid)))
             (unwrap-ok (slurp "tests/fixtures/grid.css")))))
