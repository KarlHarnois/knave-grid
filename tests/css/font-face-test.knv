(use css/font-face font-face-css)
(use font/family ->font-face ->font-family)
(use font/metrics ->font-metrics)
(use spec/body-type ->body-type)
(use spec/grid-spec ->grid-spec)
(use spec/type-area ->type-area)

(defn fake-sans-family ()
  (->font-family
    (str "Fake Sans")
    (vec (->font-face 400
                      (str "fake-sans-regular.woff2")
                      (str "tests/fixtures/fake-sans-regular.woff2")
                      (->font-metrics 1000 800 200 (some 500) 700 false))
         (->font-face 700
                      (str "fake-sans-bold.woff2")
                      (str "tests/fixtures/fake-sans-bold.woff2")
                      (->font-metrics 2000 1850 570 (some 500) 700 false)))))

(deftest overrides-each-face-with-its-metrics
  (let (spec (->grid-spec :body-type (->body-type :size 18.0
                                                  :line-height 1.5
                                                  :font-family (fake-sans-family))
                          :type-areas (vec (->type-area :name (str "page")
                                                        :width 19
                                                        :column-count 1))))
    (assert (= (font-face-css (ref spec))
               (unwrap-ok (slurp "tests/fixtures/font-faces.css"))))))
