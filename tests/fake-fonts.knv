(export ->fake-font truetype-bytes woff2-bytes)

(defstruct fake-font
  :units-per-em i64
  :hhea-ascender i64
  :hhea-descender i64
  :typo-ascender i64
  :typo-descender i64
  :uses-typo-metrics? bool
  :zero-width i64
  :transformed-hmtx? bool
  (defaults :zero-width 500 :transformed-hmtx? false))

(defstruct fake-table
  :tag string
  :woff2-index i64
  :bytes (vec u8))

(def use-typo-metrics-flag 128)

(def truetype-version 65536)

(def truetype-header-size 12)

(def table-record-size 16)

(def zero-code-point 48)

(def last-code-point 65535)

(def notdef-width 600)

(def woff2-transformed-flag 64)

(def hmtx-lsb-omitted-flags 3)

(def joined-bytes
  (rust "{0}.concat()"
    (fn ((ref (vec (vec u8)))) (vec u8))))

(def zeros
  (rust "vec![0_u8; {0} as usize]"
    (fn (i64) (vec u8))))

(def byte
  (rust "vec![{0} as u8]"
    (fn (i64) (vec u8))))

(def u16-bytes
  (rust "({0} as u16).to_be_bytes().to_vec()"
    (fn (i64) (vec u8))))

(def i16-bytes
  (rust "({0} as i16).to_be_bytes().to_vec()"
    (fn (i64) (vec u8))))

(def u32-bytes
  (rust "({0} as u32).to_be_bytes().to_vec()"
    (fn (i64) (vec u8))))

(def tag-bytes
  (rust "{0}.as_bytes().to_vec()"
    (fn ((ref str)) (vec u8))))

(def byte-count
  (rust "{0}.len() as i64"
    (fn ((ref (vec u8))) i64)))

(def base-128-bytes
  (rust "{{ let mut {!value} = {0} as u32; let mut {!groups} = vec![({!value} & 0x7f) as u8]; {!value} >>= 7; while {!value} > 0 {{ {!groups}.insert(0, ({!value} & 0x7f) as u8 | 0x80); {!value} >>= 7; }} {!groups} }}"
    (fn (i64) (vec u8))))

(def brotli-compressed
  (rust "{{ let mut {!output} = Vec::new(); brotli::BrotliCompress(&mut &{0}[..], &mut {!output}, &Default::default()).expect(\"compressing a fake font\"); {!output} }}"
    (fn ((ref (vec u8))) (vec u8))))

(type truetype-bytes
  (fn (fake-font) (vec u8)))

(defn truetype-bytes (font)
  (let (tables (truetype-tables font)
        first-offset (+ truetype-header-size
                        (* (byte-count-of tables) table-record-size)))
    (joined-bytes
      (ref (vec (u32-bytes truetype-version)
                (u16-bytes (byte-count-of tables))
                (zeros 6)
                (joined-bytes
                  (ref (table-records (ref tables) 0 first-offset (vec))))
                (joined-bytes (ref (table-bytes (ref tables)))))))))

(def byte-count-of
  (rust "{0}.len() as i64"
    (fn ((ref (vec fake-table))) i64)))

(type table-bytes
  (fn ((ref (vec fake-table)))
    (vec (vec u8))))

(defn table-bytes (tables)
  (collect (map (iter tables)
             (fn (table) (clone (:bytes table))))))

(defn table-records (tables index offset records)
  (if (= index (byte-count-of tables))
    records
    (let (table (at tables (table-position index))
          length (byte-count (ref (:bytes table)))
          record (joined-bytes (ref (vec (tag-bytes (as-str (:tag table)))
                                         (zeros 4)
                                         (u32-bytes offset)
                                         (u32-bytes length)))))
      (push! records record)
      (recur tables (+ index 1) (+ offset length) records))))

(def table-position
  (rust "{0} as usize" (fn (i64) usize)))

(type woff2-bytes
  (fn (fake-font) (vec u8)))

(defn woff2-bytes (font)
  (let (tables (woff2-tables font)
        directory (joined-bytes (ref (woff2-directory (ref tables) font)))
        compressed (brotli-compressed (ref (joined-bytes (ref (table-bytes (ref tables)))))))
    (joined-bytes (ref (vec (tag-bytes "wOF2")
                            (u32-bytes truetype-version)
                            (zeros 4)
                            (u16-bytes (byte-count-of tables))
                            (zeros 6)
                            (u32-bytes (byte-count (ref compressed)))
                            (zeros 24)
                            directory compressed)))))

(type woff2-directory
  (fn ((ref (vec fake-table)) fake-font)
    (vec (vec u8))))

(defn woff2-directory (tables font)
  (collect (map (iter tables)
             (fn (table) (woff2-entry table font)))))

(type woff2-entry
  (fn ((ref fake-table) fake-font)
    (vec u8)))

(defn woff2-entry (table font)
  (if (and (= (:tag table) "hmtx")
           (:transformed-hmtx? font))
    (joined-bytes (ref (vec
                         (byte (+ (:woff2-index table) woff2-transformed-flag))
                         (base-128-bytes (byte-count (ref (hmtx-table font))))
                         (base-128-bytes (byte-count (ref (:bytes table)))))))
    (joined-bytes (ref (vec (byte (:woff2-index table))
                            (base-128-bytes (byte-count (ref (:bytes
                                                               table)))))))))

(type truetype-tables
  (fn (fake-font) (vec fake-table)))

(defn truetype-tables (font)
  (tables-with-hmtx font (hmtx-table font)))

(type woff2-tables
  (fn (fake-font) (vec fake-table)))

(defn woff2-tables (font)
  (tables-with-hmtx font
                    (if (:transformed-hmtx? font)
                      (transformed-hmtx-table font)
                      (hmtx-table font))))

(type tables-with-hmtx
  (fn (fake-font (vec u8))
    (vec fake-table)))

(defn tables-with-hmtx (font hmtx)
  (vec (->fake-table (str "cmap") 0 (cmap-table))
       (->fake-table (str "head") 1 (head-table font))
       (->fake-table (str "hhea") 2 (hhea-table font))
       (->fake-table (str "hmtx") 3 hmtx)
       (->fake-table (str "OS/2") 6 (os2-table font))))

(defn cmap-table ()
  (joined-bytes (ref (vec (u16-bytes 0)
                          (u16-bytes 1)
                          (u16-bytes 3)
                          (u16-bytes 1)
                          (u32-bytes 12)
                          (format-4-subtable)))))

(defn format-4-subtable ()
  (let (zero-glyph-delta (- 1 zero-code-point))
    (joined-bytes (ref (vec (u16-bytes 4)
                            (u16-bytes 32)
                            (u16-bytes 0)
                            (u16-bytes 4)
                            (u16-bytes 4)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes zero-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes 0)
                            (u16-bytes zero-code-point)
                            (u16-bytes last-code-point)
                            (u16-bytes zero-glyph-delta)
                            (u16-bytes 1)
                            (u16-bytes 0)
                            (u16-bytes 0))))))

(type head-table
  (fn (fake-font) (vec u8)))

(defn head-table (font)
  (joined-bytes (ref (vec (zeros 18)
                          (u16-bytes (:units-per-em font))
                          (zeros 34)))))

(type hhea-table
  (fn (fake-font) (vec u8)))

(defn hhea-table (font)
  (joined-bytes (ref (vec (zeros 4)
                          (i16-bytes (:hhea-ascender font))
                          (i16-bytes (:hhea-descender font))
                          (zeros 26)
                          (u16-bytes 2)))))

(type hmtx-table
  (fn (fake-font) (vec u8)))

(defn hmtx-table (font)
  (joined-bytes (ref (vec (u16-bytes notdef-width)
                          (i16-bytes 0)
                          (u16-bytes (:zero-width font))
                          (i16-bytes 0)))))

(type transformed-hmtx-table
  (fn (fake-font) (vec u8)))

(defn transformed-hmtx-table (font)
  (joined-bytes (ref (vec (byte hmtx-lsb-omitted-flags)
                          (u16-bytes notdef-width)
                          (u16-bytes (:zero-width font))))))

(type os2-table
  (fn (fake-font) (vec u8)))

(defn os2-table (font)
  (joined-bytes (ref (vec (zeros 62)
                          (u16-bytes (selection-flags font))
                          (zeros 4)
                          (i16-bytes (:typo-ascender font))
                          (i16-bytes (:typo-descender font))
                          (zeros 24)))))

(defn selection-flags (font)
  (if (:uses-typo-metrics? font) use-typo-metrics-flag 0))
