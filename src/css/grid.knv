(use spec/body-type baseline-offset-px body-type)
(use browser default-font-size-px)
(use check/grid checked-grid)
(use css/declaration declaration indented)
(use css/exact-baselines exact-baseline-rules)
(use css/font-face font-face-css)
(use css/fields field-declarations field-rule)
(use css/type-styles type-style-rules)
(use spec/measure measure-columns)
(use spec/grid-spec grid-spec)
(use spec/layout layout)
(use spec/type-area span-width type-area)

(export grid-css)

(def type-area-rule
  ".type-area {
  width: min(100% - 2 * var(--_grid-margin), var(--_grid-grid-width));
  margin-inline: auto;
  padding-block: calc(var(--_grid-head) * var(--leading) - var(--_grid-baseline-offset)) calc((var(--_grid-foot) - 1) * var(--leading) + var(--_grid-baseline-offset));
}
")

(def grid-rule
  ".grid {
  display: grid;
  grid-template-columns: repeat(var(--columns), minmax(0, var(--column)));
  column-gap: var(--gutter);
}
")

(type grid-css
  (fn ((ref checked-grid)) string))

(defn grid-css (checked)
  (let (spec (:spec checked)
        all (:layouts checked))
    (str (font-face-css spec)
         "\n"
         (root-rule spec (at all 0))
         (media-rules spec all)
         "\n" type-area-rule "\n" grid-rule "\n" field-rule
         (type-style-rules spec)
         (exact-baseline-rules spec))))

(type root-rule
  (fn ((ref grid-spec) (ref layout))
    string))

(defn root-rule (spec narrowest)
  (let (type (:body-type spec))
    (str ":root {\n"
         (declaration "font-size"
                      (str (root-font-size-percent type) "%"))
         (declaration "font-family"
                      (str "\"" (:name (:font-family type)) "\""))
         (declaration "line-height" (str (:line-height type)))
         (declaration "--leading" (squares-css 1))
         (declaration "--_grid-baseline-offset"
                      (baseline-offset-rem type))
         (field-declarations type)
         (type-area-declarations (:type-area narrowest) spec)
         "}\n")))

(type media-rules
  (fn ((ref grid-spec) (ref (vec layout)))
    string))

(defn media-rules (spec all)
  (reduce (map (filter (iter all)
                 (fn (layout) (not (:narrowest? layout))))
               (fn (layout) (media-rule layout spec)))
          (str)
          (fn (rules rule) (str rules "\n" rule))))

(type media-rule
  (fn ((ref layout) (ref grid-spec))
    string))

(defn media-rule (layout spec)
  (let (root (str ":root {\n"
                  (type-area-declarations (:type-area layout) spec)
                  "}\n"))
    (str "@media (min-width: "
         (:min-width-em layout)
         "em) {\n"
         (indented (as-str root))
         "}\n")))

(type type-area-declarations
  (fn ((ref type-area) (ref grid-spec))
    string))

(defn type-area-declarations (type-area spec)
  (str (declaration "--gutter" (squares-css (:gutter type-area)))
       (declaration "--columns" (str (:column-count type-area)))
       (declaration "--column"
                    (squares-css (span-width type-area 1)))
       (declaration "--_grid-grid-width"
                    (squares-css (:width type-area)))
       (declaration "--_grid-margin"
                    (squares-css (:margin type-area)))
       (declaration "--_grid-head" (str (:head type-area)))
       (declaration "--_grid-foot" (str (:foot type-area)))
       (declaration "--measure" (measure-css type-area spec))))

(type measure-css
  (fn ((ref type-area) (ref grid-spec))
    string))

(defn measure-css (type-area spec)
  (squares-css (span-width type-area
                           (measure-columns type-area (:body-type spec)))))

(defn squares-css (count) (str count "rlh"))

(type baseline-offset-rem
  (fn ((ref body-type)) string))

(defn baseline-offset-rem (type)
  (str "calc("
       (baseline-offset-px type)
       "rem / "
       (:font-size-px type)
       ")"))

(type root-font-size-percent
  (fn ((ref body-type)) f64))

(defn root-font-size-percent (type)
  (* 100.0 (/ (:font-size-px type) default-font-size-px)))
