(use spec/body-type baseline-offset-px body-type)
(use browser default-font-size-px)
(use check/grid checked-grid)
(use css/declaration declaration indented)
(use css/exact-baselines exact-baseline-rules)
(use css/fields field-declarations field-rule)
(use css/type-styles type-style-rules)
(use spec/length length length-css)
(use spec/grid-spec breakpoint grid-spec)
(use spec/type-area span-width-ch type-area)

(export grid-css)

(def type-area-rule
  ".type-area {
  width: min(100% - 2 * var(--margin), var(--grid-width));
  margin-inline: auto;
}
")

(def grid-rule
  ".grid {
  display: grid;
  grid-template-columns: repeat(var(--columns), minmax(0, var(--column)));
  column-gap: var(--gutter);
}
")

(type grid-css
  (fn ((ref checked-grid)) string))

(defn grid-css (checked)
  (let (spec (:spec checked))
    (str (root-rule spec)
         (breakpoint-rules spec)
         "\n" type-area-rule "\n" grid-rule "\n" field-rule
         (type-style-rules spec)
         (exact-baseline-rules spec))))

(type root-rule
  (fn ((ref grid-spec)) string))

(defn root-rule (spec)
  (let (type (:body-type spec))
    (str ":root {\n"
         (declaration "font-size"
                      (str (root-font-size-percent type) "%"))
         (declaration "line-height" (str (:line-height type)))
         (declaration "--leading"
                      (length-css (ref (length/lines 1))))
         (declaration "--baseline-offset" (baseline-offset-rem type))
         (field-declarations type)
         (declaration "--measure" (str (:measure-ch spec) "ch"))
         (type-area-declarations (:type-area spec))
         "}\n")))

(type breakpoint-rules
  (fn ((ref grid-spec)) string))

(defn breakpoint-rules (spec)
  (reduce (map (iter (:breakpoints spec)) breakpoint-rule) (str)
    (fn (rules rule) (str rules "\n" rule))))

(type breakpoint-rule
  (fn ((ref breakpoint)) string))

(defn breakpoint-rule (breakpoint)
  (let (root (str ":root {\n"
                  (type-area-declarations (:type-area breakpoint))
                  "}\n"))
    (str "@media (min-width: "
         (:min-width-em breakpoint)
         "em) {\n"
         (indented (as-str root))
         "}\n")))

(type type-area-declarations
  (fn ((ref type-area)) string))

(defn type-area-declarations (type-area)
  (str (declaration "--gutter" (str (:gutter-ch type-area) "ch"))
       (declaration "--columns" (str (:column-count type-area)))
       (declaration "--column"
                    (str (span-width-ch type-area 1) "ch"))
       (declaration "--grid-width"
                    (str (:width-ch type-area) "ch"))
       (declaration "--margin" (str (:margin-ch type-area) "ch"))))

(type baseline-offset-rem
  (fn ((ref body-type)) string))

(defn baseline-offset-rem (type)
  (str "calc("
       (baseline-offset-px type)
       "rem / "
       (:font-size-px type)
       ")"))

(type root-font-size-percent
  (fn ((ref body-type)) f64))

(defn root-font-size-percent (type)
  (* 100.0 (/ (:font-size-px type) default-font-size-px)))
