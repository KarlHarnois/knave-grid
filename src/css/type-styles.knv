(use css/declaration declaration)
(use spec/body-type body-type)
(use spec/grid-spec grid-spec)

(use spec/type-style style-font-size-px style-shift-px
                     type-style)

(export type-style-rules)

(type type-style-rules
  (fn ((ref grid-spec)) string))

(defn type-style-rules (spec)
  (reduce (map (iter (:type-styles spec))
            (fn (style)
              (type-style-rule style (:body-type spec))))
          (str)
          (fn (rules rule) (str rules "\n" rule))))

(type type-style-rule
  (fn ((ref type-style) (ref body-type))
    string))

(defn type-style-rule (style body)
  (let (shift (style-shift-px style body))
    (str "."
         (class-name (as-str (:name style)))
         " {\n"
         (declaration "font-size"
                      (relative-to-body (style-font-size-px style body) body))
         (declaration "line-height" (str (:lines style) "rlh"))
         (if (= shift 0.0)
           (str)
           (str (declaration "position" "relative")
                (declaration "top" (relative-to-body shift body))))
         "}\n")))

(defn class-name (style-name) (str "type-" style-name))

(type relative-to-body
  (fn (f64 (ref body-type)) string))

(defn relative-to-body (px body)
  (str "calc(" px "rem / " (:font-size-px body) ")"))
