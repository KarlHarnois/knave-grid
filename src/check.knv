(use lattice column-width-ch fits? fitting-column-counts
             lattice)

(use spec grid-spec)

(export ->checked-grid check-grid checked-grid grid-error
        grid-warning)

(def narrowest-column-ch 45)

(def widest-column-ch 75)

(defenum grid-error
  (lattice-does-not-fit :lattice lattice
                        :fitting-counts (vec i64)))

(display grid-error (error)
  (match error
    ((lattice-does-not-fit lattice fitting-counts)
     (str "a lattice of "
          (:width-ch lattice)
          "ch with a gutter of "
          (:gutter-ch lattice)
          "ch does not fit "
          (:column-count lattice)
          " columns; the column counts that fit are "
          (joined-counts fitting-counts)))))

(def joined-counts
  (rust "{0}.iter().map(|count| count.to_string()).collect::<Vec<_>>().join(\", \")"
    (fn ((ref (vec i64))) string)))

(defenum grid-warning
  (column-width-out-of-range :column-width-ch i64))

(display grid-warning (warning)
  (match warning
    ((column-width-out-of-range column-width-ch)
     (str "the column width of " column-width-ch
          "ch is outside " narrowest-column-ch "ch to "
          widest-column-ch "ch"))))

(defstruct checked-grid
  :spec grid-spec
  :warnings (vec grid-warning))

(type check-grid
  (fn (grid-spec) (result checked-grid grid-error)))

(defn check-grid (spec)
  (let (lattice (:lattice spec))
    (if (fits? lattice)
      (ok (->checked-grid spec (column-width-warnings lattice)))
      (err (grid-error/lattice-does-not-fit (deref lattice)
                                            (fitting-column-counts lattice))))))

(defn column-width-warnings (lattice)
  (let (column-width (column-width-ch lattice))
    (if (readable-column-width? column-width)
      (vec)
      (vec (grid-warning/column-width-out-of-range column-width)))))

(defn readable-column-width? (column-width)
  (and (>= column-width narrowest-column-ch)
       (<= column-width widest-column-ch)))
