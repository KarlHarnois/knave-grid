(export brotli-decompressed byte-at bytes-from i16-at
        read-bytes tag-at u16-at u32-at)

(def read-bytes
  (rust "std::fs::read({0}).map_err(|error| error.to_string())"
    (fn ((ref str))
      (result (vec u8) string))))

(def brotli-decompressed
  (rust "{{ let mut {!output} = Vec::new(); brotli_decompressor::BrotliDecompress(&mut &{0}[..], &mut {!output}).ok().map(|_| {!output}) }}"
    (fn ((ref (vec u8))) (option (vec u8)))))

(def byte-at
  (rust "usize::try_from({1}).ok().and_then(|start| {0}.get(start)).map(|byte| i64::from(*byte))"
    (fn ((ref (vec u8)) i64) (option i64))))

(def u16-at
  (rust "usize::try_from({1}).ok().and_then(|start| {0}.get(start..start + 2)).map(|bytes| i64::from(u16::from_be_bytes([bytes[0], bytes[1]])))"
    (fn ((ref (vec u8)) i64) (option i64))))

(def i16-at
  (rust "usize::try_from({1}).ok().and_then(|start| {0}.get(start..start + 2)).map(|bytes| i64::from(i16::from_be_bytes([bytes[0], bytes[1]])))"
    (fn ((ref (vec u8)) i64) (option i64))))

(def u32-at
  (rust "usize::try_from({1}).ok().and_then(|start| {0}.get(start..start + 4)).map(|bytes| i64::from(u32::from_be_bytes([bytes[0], bytes[1], bytes[2], bytes[3]])))"
    (fn ((ref (vec u8)) i64) (option i64))))

(def tag-at
  (rust "usize::try_from({1}).ok().and_then(|start| {0}.get(start..start + 4)).map(|bytes| String::from_utf8_lossy(bytes).into_owned())"
    (fn ((ref (vec u8)) i64)
      (option string))))

(def bytes-from
  (rust "usize::try_from({1}).ok().zip(usize::try_from({2}).ok()).and_then(|(start, length)| {0}.get(start..start + length)).map(<[u8]>::to_vec)"
    (fn ((ref (vec u8)) i64 i64)
      (option (vec u8)))))
