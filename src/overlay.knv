(export overlay-css overlay-javascript)

(def overlay-css
  ":root.grid-overlay body {
  position: relative;
}

:root.grid-overlay body::after {
  content: \"\";
  position: absolute;
  inset: 0;
  z-index: 2147483647;
  width: min(100%, var(--grid-width));
  margin-inline: auto;
  background:
    repeating-linear-gradient(to bottom, transparent 0 calc(var(--leading) - 1px), rgb(255 64 160 / 0.6) calc(var(--leading) - 1px) var(--leading)),
    repeating-linear-gradient(to right, rgb(64 160 255 / 0.15) 0 var(--column), transparent var(--column) calc(var(--column) + var(--gutter)));
  pointer-events: none;
}
")

(def overlay-javascript
  "class GridOverlay {
  static #CLASS_NAME = \"grid-overlay\";
  static #QUERY_PARAMETER = \"grid\";
  static #TOGGLE_KEY = \"g\";
  static #FORM_FIELDS = \"input, textarea, select\";

  static start() {
    if (GridOverlay.#isRequested()) GridOverlay.#classes().add(GridOverlay.#CLASS_NAME);
    document.addEventListener(\"keydown\", (event) => {
      if (GridOverlay.#isToggle(event)) GridOverlay.#classes().toggle(GridOverlay.#CLASS_NAME);
    });
  }

  static #isRequested() {
    return new URLSearchParams(location.search).has(GridOverlay.#QUERY_PARAMETER);
  }

  static #isToggle(event) {
    return event.key === GridOverlay.#TOGGLE_KEY
      && !event.ctrlKey && !event.metaKey && !event.altKey
      && !GridOverlay.#isTextField(event.target);
  }

  static #isTextField(target) {
    return target.isContentEditable || Boolean(target.closest?.(GridOverlay.#FORM_FIELDS));
  }

  static #classes() {
    return document.documentElement.classList;
  }
}

GridOverlay.start();
")
