; Generated by `knave task embed-assets` from assets/. Edit those files instead.

(export overlay-css overlay-javascript)

(def overlay-css
  ":root.grid-overlay body,
:root.grid-guides body {
  position: relative;
}

:root.grid-overlay body::after,
:root.grid-guides body::before {
  content: \"\";
  position: absolute;
  inset: 0;
  z-index: 2147483647;
  width: min(100% - 2 * var(--_grid-margin), var(--_grid-grid-width));
  margin-inline: auto;
  pointer-events: none;
}

@supports (width: round(down, 1px, 1px)) {
  :root.grid-overlay body::after,
  :root.grid-guides body::before {
    width: min(round(down, 100% - 2 * var(--_grid-margin), var(--leading)), var(--_grid-grid-width));
  }
}

:root.grid-overlay body::after {
  box-shadow: inset 0 -1px rgb(255 64 160 / 0.6);
  background:
    linear-gradient(to bottom, transparent 0 var(--_grid-baseline-offset), rgb(255 64 160 / 0.6) var(--_grid-baseline-offset) calc(var(--_grid-baseline-offset) + 1px), transparent calc(var(--_grid-baseline-offset) + 1px)) 0 calc(-1 * var(--_grid-baseline-offset)) / 100% var(--leading) repeat-y,
    linear-gradient(to right, rgb(64 160 255 / 0.15) 0 calc(100% - var(--gutter)), transparent calc(100% - var(--gutter))) 0 0 / calc((100% + var(--gutter)) / var(--columns)) 100% repeat-x;
}

:root.grid-guides body::before {
  background: linear-gradient(to bottom, transparent 0 var(--_grid-cap-top), rgb(255 190 60 / 0.35) var(--_grid-cap-top) calc(var(--_grid-cap-top) + 1px), transparent calc(var(--_grid-cap-top) + 1px) var(--_grid-descender-bottom), rgb(255 190 60 / 0.35) var(--_grid-descender-bottom) calc(var(--_grid-descender-bottom) + 1px), transparent calc(var(--_grid-descender-bottom) + 1px)) 0 calc(-1 * var(--_grid-baseline-offset)) / 100% var(--leading) repeat-y;
}

:root.grid-overlay .type-area {
  background: linear-gradient(to bottom, transparent 0 var(--field), rgb(255 255 255 / 0.08) var(--field) var(--field-pitch)) 0 0 / 100% var(--field-pitch) repeat-y content-box;
}
")

(def overlay-javascript
  "class RootClassToggle {
  static #FORM_FIELDS = \"input, textarea, select\";

  #className;
  #queryParameter;
  #buttons;
  #key;

  constructor({ className, queryParameter, buttons, key = null }) {
    this.#className = className;
    this.#queryParameter = queryParameter;
    this.#buttons = buttons;
    this.#key = key;
  }

  start() {
    if (this.#isRequested()) this.#classes().add(this.#className);
    document.addEventListener(\"keydown\", (event) => {
      if (this.#isToggleKey(event)) this.#toggle();
    });
    document.addEventListener(\"click\", (event) => {
      if (event.target.closest?.(this.#buttons)) this.#toggle();
    });
    this.#markButtons();
  }

  #isRequested() {
    return new URLSearchParams(location.search).has(this.#queryParameter);
  }

  #isToggleKey(event) {
    return this.#key !== null
      && event.key === this.#key
      && !event.ctrlKey && !event.metaKey && !event.altKey
      && !RootClassToggle.#isTextField(event.target);
  }

  static #isTextField(target) {
    return target.isContentEditable || Boolean(target.closest?.(RootClassToggle.#FORM_FIELDS));
  }

  #toggle() {
    this.#classes().toggle(this.#className);
    this.#markButtons();
  }

  #markButtons() {
    const shown = String(this.#classes().contains(this.#className));
    document.querySelectorAll(this.#buttons)
      .forEach((button) => button.setAttribute(\"aria-pressed\", shown));
  }

  #classes() {
    return document.documentElement.classList;
  }
}

new RootClassToggle({
  className: \"grid-overlay\",
  queryParameter: \"grid\",
  buttons: \"[data-grid-toggle]\",
  key: \"g\",
}).start();

new RootClassToggle({
  className: \"grid-guides\",
  queryParameter: \"guides\",
  buttons: \"[data-grid-guides-toggle]\",
}).start();
")
