(use font/family family-metrics font-family)
(use font/weight weight-number)
(use font/metrics font-metrics)

(use spec/body-type baseline-offset-px body-metrics
                    body-type body-weight leading-px)

(use spec/hanging hanging-line)
(use spec/line-box baseline-in-line-px)

(export ->type-style style-baseline-line style-family-name
        style-font-size-px style-line-height-px
        style-metrics style-shift-px style-weight
        type-style)

(defstruct type-style
  :name string
  :lines i64
  :size (option f64)
  :font-family (option font-family)
  :weight (option string)
  :baseline-line (option i64)
  :selector (option string)
  (defaults :size none
            :font-family none
            :weight none
            :baseline-line none
            :selector none))

(type style-weight
  (fn ((ref type-style) (ref body-type))
    i64))

(defn style-weight (style body)
  (match (:weight style)
    ((some name)
     (unwrap-or (weight-number (as-str name))
                (body-weight body)))
    (none (body-weight body))))

(type style-family-name
  (fn ((ref type-style) (ref body-type))
    string))

(defn style-family-name (style body)
  (match (:font-family style)
    ((some family) (clone (:name family)))
    (none (clone (:name (:font-family body))))))

(def float-of
  (rust "{0} as f64" (fn (i64) f64)))

(type style-font-size-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-font-size-px (style body)
  (match (:size style)
    ((some size) size)
    (none (* (float-of (:lines style)) (:size body)))))

(type style-line-height-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-line-height-px (style body)
  (* (float-of (:lines style))
     (leading-px body)))

(type style-shift-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-shift-px (style body)
  (let (baseline (baseline-in-line-px (ref (style-metrics style body))
                                      (style-font-size-px style body)
                                      (style-line-height-px style body)))
    (- (grid-baseline-px style body) baseline)))

(type style-baseline-line
  (fn ((ref type-style) (ref body-type))
    i64))

(defn style-baseline-line (style body)
  (match (:baseline-line style)
    ((some line) line)
    (none (hanging-line (ref (style-metrics style body))
                        (style-font-size-px style body)
                        body))))

(type grid-baseline-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn grid-baseline-px (style body)
  (+ (* (float-of (- (style-baseline-line style body) 1))
        (leading-px body))
     (baseline-offset-px body)))

(type style-metrics
  (fn ((ref type-style) (ref body-type))
    font-metrics))

(defn style-metrics (style body)
  (match (:font-family style)
    ((some family)
     (deref (family-metrics family (style-weight style body))))
    (none (deref (family-metrics (:font-family body)
                                 (style-weight style body))))))
