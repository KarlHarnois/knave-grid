(use font/face font-face)
(use font/metrics font-metrics)
(use spec/body-type baseline-offset-px body-type leading-px)
(use spec/line-box baseline-in-line-px)

(export ->type-style style-font-size-px style-line-height-px
        style-metrics style-shift-px type-style)

(defstruct type-style
  :name string
  :lines i64
  :font-size-px (option f64)
  :face (option font-face)
  (defaults :font-size-px none :face none))

(def float-of
  (rust "{0} as f64" (fn (i64) f64)))

(def rounded
  (rust "{0}.round()" (fn (f64) f64)))

(type style-font-size-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-font-size-px (style body)
  (match (:font-size-px style)
    ((some size) size)
    (none (* (float-of (:lines style)) (:font-size-px body)))))

(type style-line-height-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-line-height-px (style body)
  (* (float-of (:lines style))
     (leading-px body)))

(type style-shift-px
  (fn ((ref type-style) (ref body-type))
    f64))

(defn style-shift-px (style body)
  (let (baseline (baseline-in-line-px (ref (style-metrics style body))
                                      (style-font-size-px style body)
                                      (style-line-height-px style body)))
    (- (nearest-grid-baseline-px style body baseline) baseline)))

(type nearest-grid-baseline-px
  (fn ((ref type-style) (ref body-type) f64)
    f64))

(defn nearest-grid-baseline-px (style body baseline)
  (let (leading (leading-px body)
        body-baseline (baseline-offset-px body)
        last-line (float-of (- (:lines style) 1))
        line (rounded (/ (- baseline body-baseline) leading))
        line-in-block (cond
                        ((< line 0.0) 0.0)
                        ((> line last-line) last-line)
                        (else line)))
    (+ (* line-in-block leading) body-baseline)))

(type style-metrics
  (fn ((ref type-style) (ref body-type))
    font-metrics))

(defn style-metrics (style body)
  (match (:face style)
    ((some face) (deref (:metrics face)))
    (none (deref (:metrics body)))))
