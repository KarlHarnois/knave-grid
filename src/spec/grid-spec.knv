(use spec/body-type body-type)
(use spec/type-area type-area)
(use spec/type-style type-style)

(export ->grid-spec grid-spec)

(defstruct grid-spec
  :body-type body-type
  :type-areas (vec type-area)
  :measure-ch i64
  :type-styles (vec type-style)
  (defaults :measure-ch 66 :type-styles (vec)))
