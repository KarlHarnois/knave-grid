(use font/family family-metrics font-family)
(use font/weight weight-number)
(use font/metrics font-metrics)
(use spec/line-box baseline-in-line-px)

(export ->body-type baseline-offset-px body-metrics
        body-type body-weight ch-px leading-px)

(defstruct body-type
  :size f64
  :line-height f64
  :font-family font-family
  :weight string
  (defaults :weight (str "regular")))

(type body-weight
  (fn ((ref body-type)) i64))

(defn body-weight (type)
  (unwrap-or (weight-number (as-str (:weight type)))
             regular-weight))

(def regular-weight 400)

(type body-metrics
  (fn ((ref body-type))
    (ref font-metrics)))

(defn body-metrics (type)
  (family-metrics (:font-family type) (body-weight type)))

(def float-of
  (rust "{0} as f64" (fn (i64) f64)))

(type leading-px
  (fn ((ref body-type)) f64))

(defn leading-px (type)
  (* (:size type) (:line-height type)))

(type baseline-offset-px
  (fn ((ref body-type)) f64))

(defn baseline-offset-px (type)
  (baseline-in-line-px (body-metrics type)
                       (:size type)
                       (leading-px type)))

(type ch-px (fn ((ref body-type)) f64))

(defn ch-px (type)
  (let (metrics (body-metrics type))
    (/ (* (:size type)
          (float-of (unwrap-or (:zero-width metrics) (:units-per-em metrics))))
       (float-of (:units-per-em metrics)))))
