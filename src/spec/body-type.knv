(use font/metrics font-metrics)
(use spec/line-box baseline-in-line-px)

(export ->body-type baseline-offset-px body-type ch-px
        leading-px)

(defstruct body-type
  :font-size-px f64
  :line-height f64
  :metrics font-metrics)

(def float-of
  (rust "{0} as f64" (fn (i64) f64)))

(type leading-px
  (fn ((ref body-type)) f64))

(defn leading-px (type)
  (* (:font-size-px type) (:line-height type)))

(type baseline-offset-px
  (fn ((ref body-type)) f64))

(defn baseline-offset-px (type)
  (baseline-in-line-px (:metrics type)
                       (:font-size-px type)
                       (leading-px type)))

(type ch-px (fn ((ref body-type)) f64))

(defn ch-px (type)
  (let (metrics (:metrics type))
    (/ (* (:font-size-px type)
          (float-of (:zero-width metrics)))
       (float-of (:units-per-em metrics)))))
