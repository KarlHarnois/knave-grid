(export ->type-area fits? fitting-column-counts
        span-width-ch type-area)

(defstruct type-area
  :width-ch i64
  :gutter-ch i64
  :column-count i64)

(type column-width-ch
  (fn ((ref type-area)) i64))

(defn column-width-ch (type-area)
  (span-width-ch type-area 1))

(type span-width-ch
  (fn ((ref type-area) i64) i64))

(defn span-width-ch (type-area column-count)
  (- (* column-count (track-width-ch type-area))
     (:gutter-ch type-area)))

(type track-width-ch
  (fn ((ref type-area)) i64))

(defn track-width-ch (type-area)
  (/ (width-with-gutter-ch type-area)
     (:column-count type-area)))

(type fits? (fn ((ref type-area)) bool))

(defn fits? (type-area)
  (fits-column-count? type-area (:column-count type-area)))

(type fitting-column-counts
  (fn ((ref type-area)) (vec i64)))

(defn fitting-column-counts (type-area)
  (collect (filter (range 1 (+ (width-with-gutter-ch type-area) 1))
             (fn (column-count)
               (fits-column-count? type-area (deref column-count))))))

(type fits-column-count?
  (fn ((ref type-area) i64) bool))

(defn fits-column-count? (type-area column-count)
  (and (> column-count 0)
       (divides? column-count (width-with-gutter-ch type-area))
       (> (/ (width-with-gutter-ch type-area) column-count)
          (:gutter-ch type-area))))

(defn divides? (divisor total)
  (= (rem total divisor) 0))

(type width-with-gutter-ch
  (fn ((ref type-area)) i64))

(defn width-with-gutter-ch (type-area)
  (+ (:width-ch type-area) (:gutter-ch type-area)))
