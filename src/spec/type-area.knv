(export ->type-area fits? fitting-column-counts span-width
        type-area)

(defstruct type-area
  :name string
  :width i64
  :gutter i64
  :column-count i64
  :margin i64
  :head i64
  :foot i64
  :measure-columns (option i64)
  (defaults :gutter 1
            :margin 1
            :head 2
            :foot 2
            :measure-columns none))

(type span-width
  (fn ((ref type-area) i64) i64))

(defn span-width (type-area column-count)
  (- (* column-count (track-width type-area))
     (:gutter type-area)))

(type track-width
  (fn ((ref type-area)) i64))

(defn track-width (type-area)
  (/ (width-with-gutter type-area) (:column-count type-area)))

(type fits? (fn ((ref type-area)) bool))

(defn fits? (type-area)
  (fits-column-count? type-area (:column-count type-area)))

(type fitting-column-counts
  (fn ((ref type-area)) (vec i64)))

(defn fitting-column-counts (type-area)
  (collect (filter (range 1 (+ (width-with-gutter type-area) 1))
             (fn (column-count)
               (fits-column-count? type-area (deref column-count))))))

(type fits-column-count?
  (fn ((ref type-area) i64) bool))

(defn fits-column-count? (type-area column-count)
  (and (> column-count 0)
       (divides? column-count (width-with-gutter type-area))
       (> (/ (width-with-gutter type-area) column-count)
          (:gutter type-area))))

(defn divides? (divisor total)
  (= (rem total divisor) 0))

(type width-with-gutter
  (fn ((ref type-area)) i64))

(defn width-with-gutter (type-area)
  (+ (:width type-area) (:gutter type-area)))
