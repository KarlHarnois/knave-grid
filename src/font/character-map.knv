(use font/bytes u16-at u32-at)

(use font/tables font-error font-tables malformed present
                 table-offset)

(export glyph-for)

(def glyph-id-modulus 65536)

(def format-12-group-size 12)

(type glyph-for
  (fn ((ref font-tables) i64)
    (result (option i64) font-error)))

(defn glyph-for (tables code-point)
  (let (data (:data tables)
        subtable (try
                   (unicode-subtable data (try (table-offset tables "cmap")) 0))
        format (try (present (u16-at data subtable)))
        glyph (if (= format 4)
                (try (format-4-glyph data subtable code-point))
                (try (format-12-glyph data subtable code-point))))
    (ok (if (= glyph 0) none (some glyph)))))

(defn unicode-subtable (data cmap index)
  (let (record-count (try (present (u16-at data (+ cmap 2))))
        record (+ cmap 4 (* 8 index)))
    (if (= index record-count)
      (malformed
        "the font maps no Unicode characters in a format the library reads")
      (let (platform (try (present (u16-at data record)))
            encoding (try (present (u16-at data (+ record 2))))
            subtable (+ cmap
                        (try (present (u32-at data (+ record 4)))))
            format (try (present (u16-at data subtable))))
        (if (and (unicode-encoding? platform encoding)
                 (or (= format 4) (= format 12)))
          (ok subtable)
          (recur data cmap (+ index 1)))))))

(defn unicode-encoding? (platform encoding)
  (or (= platform 0)
      (and (= platform 3)
           (or (= encoding 1) (= encoding 10)))))

(defn format-4-glyph (data subtable code-point)
  (let (segment-count (/ (try (present (u16-at data (+ subtable 6))))
                         2)
        ends (+ subtable 14)
        starts (+ ends (* 2 segment-count) 2)
        deltas (+ starts (* 2 segment-count))
        range-offsets (+ deltas (* 2 segment-count))
        segment (try (segment-ending-at-or-after
                       data ends segment-count code-point
                       0))
        start (try (present (u16-at data (+ starts (* 2 segment)))))
        delta (try (present (u16-at data (+ deltas (* 2 segment)))))
        range-offset-position (+ range-offsets (* 2 segment))
        range-offset (try (present (u16-at data range-offset-position))))
    (cond
      ((> start code-point) (ok 0))
      ((= range-offset 0)
       (ok (rem (+ code-point delta) glyph-id-modulus)))
      (else (let (glyph (try (present (u16-at data
                                              (+ range-offset-position
                                                 range-offset
                                                 (* 2 (- code-point start)))))))
              (ok (if (= glyph 0)
                    0
                    (rem (+ glyph delta) glyph-id-modulus))))))))

(defn segment-ending-at-or-after (data ends segment-count code-point segment)
  (cond
    ((= segment segment-count)
     (malformed "the font's character map has no final segment"))
    ((>= (try (present (u16-at data (+ ends (* 2 segment)))))
         code-point)
     (ok segment))
    (else (recur data ends segment-count code-point (+ segment 1)))))

(defn format-12-glyph (data subtable code-point)
  (format-12-group-glyph data
                         (+ subtable 16)
                         (try (present (u32-at data (+ subtable 12))))
                         code-point))

(defn format-12-group-glyph (data group remaining code-point)
  (if (= remaining 0)
    (ok 0)
    (let (first (try (present (u32-at data group)))
          last (try (present (u32-at data (+ group 4)))))
      (if (and (<= first code-point) (<= code-point last))
        (ok (+ (try (present (u32-at data (+ group 8))))
               (- code-point first)))
        (recur data
               (+ group format-12-group-size)
               (- remaining 1)
               code-point)))))
