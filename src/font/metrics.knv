(use font/bytes i16-at read-bytes tag-at u16-at u32-at)
(use font/character-map glyph-for)
(use font/sfnt sfnt-signature? sfnt-tables)

(use font/tables font-error font-tables malformed present
                 table-entry-for table-offset)

(use font/woff2 woff2-tables)

(export ->font-metrics font-error font-metrics
        parse-font-metrics read-font-metrics)

(defstruct font-metrics
  :units-per-em i64
  :ascent i64
  :descent i64
  :zero-width (option i64)
  :cap-height i64
  :monospace? bool)

(def zero-code-point 48)

(def units-per-em-offset 18)

(def hhea-ascender-offset 4)

(def hhea-descender-offset 6)

(def hhea-metric-count-offset 34)

(def os2-cap-height-offset 88)

(def first-os2-version-with-cap-height 2)

(def post-fixed-pitch-offset 12)

(type read-font-metrics
  (fn ((ref str))
    (result font-metrics font-error)))

(defn read-font-metrics (path)
  (match (read-bytes path)
    ((err reason)
     (err (font-error/unreadable (str path) reason)))
    ((ok bytes) (parse-font-metrics (ref bytes)))))

(type parse-font-metrics
  (fn ((ref (vec u8)))
    (result font-metrics font-error)))

(defn parse-font-metrics (bytes)
  (let (tables (try (font-tables-of bytes)))
    (metrics-from (ref tables))))

(type font-tables-of
  (fn ((ref (vec u8)))
    (result font-tables font-error)))

(defn font-tables-of (bytes)
  (let (signature (try (present (tag-at bytes 0))))
    (cond
      ((= signature "wOF2") (woff2-tables bytes))
      ((sfnt-signature? (as-str signature)) (sfnt-tables bytes))
      (else (malformed "not a TrueType, OpenType or WOFF2 font")))))

(type metrics-from
  (fn ((ref font-tables))
    (result font-metrics font-error)))

(defn metrics-from (tables)
  (let (data (:data tables)
        head (try (table-offset tables "head"))
        hhea (try (table-offset tables "hhea"))
        zero-glyph (try (glyph-for tables zero-code-point)))
    (ok (->font-metrics
          (try (present (u16-at data (+ head units-per-em-offset))))
          (try (present (i16-at data (+ hhea hhea-ascender-offset))))
          (- 0
             (try (present (i16-at data (+ hhea hhea-descender-offset)))))
          (try (zero-width tables zero-glyph))
          (try (cap-height tables))
          (try (monospace? tables))))))

(type zero-width
  (fn ((ref font-tables) (option i64))
    (result (option i64) font-error)))

(defn zero-width (tables zero-glyph)
  (match zero-glyph
    ((some glyph)
     (ok (some (try (advance-width tables glyph)))))
    (none (ok none))))

(type advance-width
  (fn ((ref font-tables) i64)
    (result i64 font-error)))

(defn advance-width (tables glyph)
  (let (data (:data tables)
        hhea (try (table-offset tables "hhea"))
        metric-count (try (present (u16-at data
                                           (+ hhea hhea-metric-count-offset))))
        metric (if (< glyph metric-count) glyph (- metric-count 1))
        hmtx (try (table-entry-for tables "hmtx")))
    (present (u16-at data (advance-position (ref hmtx) metric)))))

(defn advance-position (hmtx metric)
  (if (:transformed? hmtx)
    (+ (:offset hmtx) 1 (* 2 metric))
    (+ (:offset hmtx) (* 4 metric))))

(type cap-height
  (fn ((ref font-tables))
    (result i64 font-error)))

(defn cap-height (tables)
  (let (data (:data tables)
        os2 (try (table-offset tables "OS/2"))
        version (try (present (u16-at data os2))))
    (if (< version first-os2-version-with-cap-height)
      (malformed "the font's OS/2 table is older than version 2, so it has no cap height")
      (present (i16-at data (+ os2 os2-cap-height-offset))))))

(type monospace?
  (fn ((ref font-tables))
    (result bool font-error)))

(defn monospace? (tables)
  (match (table-offset tables "post")
    ((err _) (ok false))
    ((ok post)
     (ok (not= (try (present (u32-at (:data tables)
                                     (+ post post-fixed-pitch-offset))))
               0)))))
