(export ->lattice column-width-ch fits?
        fitting-column-counts lattice span-width-ch)

(defstruct lattice
  :width-ch i64
  :gutter-ch i64
  :column-count i64)

(type column-width-ch
  (fn ((ref lattice)) i64))

(defn column-width-ch (lattice) (span-width-ch lattice 1))

(type span-width-ch
  (fn ((ref lattice) i64) i64))

(defn span-width-ch (lattice column-count)
  (- (* column-count (track-width-ch lattice))
     (:gutter-ch lattice)))

(type track-width-ch
  (fn ((ref lattice)) i64))

(defn track-width-ch (lattice)
  (/ (width-with-gutter-ch lattice) (:column-count lattice)))

(type fits? (fn ((ref lattice)) bool))

(defn fits? (lattice)
  (fits-column-count? lattice (:column-count lattice)))

(type fitting-column-counts
  (fn ((ref lattice)) (vec i64)))

(defn fitting-column-counts (lattice)
  (collect (filter (range 1 (+ (width-with-gutter-ch lattice) 1))
             (fn (column-count)
               (fits-column-count? lattice (deref column-count))))))

(type fits-column-count?
  (fn ((ref lattice) i64) bool))

(defn fits-column-count? (lattice column-count)
  (and (> column-count 0)
       (divides? column-count (width-with-gutter-ch lattice))
       (> (/ (width-with-gutter-ch lattice) column-count)
          (:gutter-ch lattice))))

(defn divides? (divisor total)
  (= (rem total divisor) 0))

(type width-with-gutter-ch
  (fn ((ref lattice)) i64))

(defn width-with-gutter-ch (lattice)
  (+ (:width-ch lattice) (:gutter-ch lattice)))
