(export ->lattice column-width-ch lattice span-width-ch)

(defstruct lattice
  :width-ch i64
  :gutter-ch i64
  :column-count i64)

(type column-width-ch
  (fn ((ref lattice)) i64))

(defn column-width-ch (lattice) (span-width-ch lattice 1))

(type span-width-ch
  (fn ((ref lattice) i64) i64))

(defn span-width-ch (lattice column-count)
  (- (* column-count (track-width-ch lattice))
     (:gutter-ch lattice)))

(defn track-width-ch (lattice)
  (/ (+ (:width-ch lattice) (:gutter-ch lattice))
     (:column-count lattice)))
