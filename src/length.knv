(export length length-css)

(defenum length
  (px f64)
  (ch f64)
  (rem f64)
  (lines i64)
  (columns i64))

(type length-css
  (fn ((ref length)) string))

(defn length-css (length)
  (match length
    ((px size) (str size "px"))
    ((ch size) (str size "ch"))
    ((rem size) (str size "rem"))
    ((lines count) (str count "rlh"))
    ((columns count) (columns-css (deref count)))))

(defn columns-css (count)
  (if (= count 1)
    (str "var(--column)")
    (str "calc(" count " * var(--column) + "
         (- count 1)
         " * var(--gutter))")))
