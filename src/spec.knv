(use body-type body-type)
(use type-area type-area)

(export ->breakpoint ->grid-spec breakpoint grid-spec)

(defstruct breakpoint
  :min-width-em f64
  :type-area type-area)

(defstruct grid-spec
  :body-type body-type
  :type-area type-area
  :measure-ch i64
  :breakpoints (vec breakpoint)
  (defaults :measure-ch 66 :breakpoints (vec)))
