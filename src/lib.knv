(use spec/body-type ->body-type baseline-offset-px
                    leading-px)

(use check/grid check-grid checked-grid grid-error
                grid-warning)

(use css/grid grid-css)
(use css/font-face font-face-css)
(use font/face ->font-face font-face)

(use font/metrics ->font-metrics font-error font-metrics
                  parse-font-metrics read-font-metrics)

(use spec/length length length-css)
(use spec/measure measure-columns)
(use overlay overlay-css overlay-javascript)
(use spec/grid-spec ->grid-spec)
(use spec/layout layout-label)

(use spec/type-style ->type-style style-font-size-px
                     style-shift-px type-style)

(use spec/type-area ->type-area)

(export ->body-type ->font-face ->font-metrics ->grid-spec
        ->type-area ->type-style baseline-offset-px
        check-grid checked-grid font-error font-face
        font-face-css font-metrics grid-css grid-error
        grid-warning layout-label leading-px length
        length-css measure-columns overlay-css
        overlay-javascript parse-font-metrics
        read-font-metrics style-font-size-px style-shift-px
        type-style)
