(use check/grid checked-grid)
(use css/font-face font-folder spec-families)
(use css/grid grid-css)
(use font/family font-face font-family)

(export write-error write-grid)

(defenum write-error
  (unwritable :path string :reason string))

(display write-error (error)
  (match error
    ((unwritable path reason)
     (str "cannot write " path ": " reason))))

(def create-directories
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def copy-file
  (rust "std::fs::copy({0}, {1}).map(drop).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def write-file
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def sibling-path
  (rust "std::path::Path::new({0}).with_file_name({1}).to_string_lossy().into_owned()"
    (fn ((ref str) (ref str)) string)))

(type write-grid
  (fn ((ref checked-grid) (ref str))
    (result unit write-error)))

(defn write-grid (checked stylesheet-path)
  (let (font-directory (sibling-path stylesheet-path font-folder))
    (try (written (as-str font-directory)
                  (create-directories (as-str font-directory))))
    (try (copy-faces (spec-families (:spec checked))
                     (as-str font-directory)
                     0))
    (written stylesheet-path
             (write-file stylesheet-path (as-str (grid-css checked))))))

(type copy-faces
  (fn ((vec font-family) (ref str) usize)
    (result unit write-error)))

(defn copy-faces (families font-directory index)
  (if (>= index (len families))
    (ok (do))
    (do
      (try (copy-family-faces (at families index) font-directory 0))
      (recur families font-directory (+ index 1)))))

(type copy-family-faces
  (fn ((ref font-family) (ref str) usize)
    (result unit write-error)))

(defn copy-family-faces (family font-directory index)
  (if (>= index (len (:faces family)))
    (ok (do))
    (let (face (at (:faces family) index)
          target (str font-directory "/" (:file-name face)))
      (try (written (as-str target)
                    (copy-file (as-str (:path face))
                               (as-str target))))
      (recur family font-directory (+ index 1)))))

(type written
  (fn ((ref str) (result unit string))
    (result unit write-error)))

(defn written (path outcome)
  (map-err outcome
    (fn (reason)
      (write-error/unwritable (str path) reason))))
