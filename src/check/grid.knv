(use check/measure check-measure measure-warnings)
(use check/font-weights check-font-weights)
(use check/fields check-fields)
(use check/page-margins check-page-margins)
(use check/problems grid-error grid-warning)
(use check/square check-square)
(use check/type-styles check-type-styles)
(use spec/grid-spec grid-spec)
(use spec/layout layout layout-label layouts)
(use spec/type-area fits? fitting-column-counts)

(export ->checked-grid check-grid checked-grid grid-error
        grid-warning)

(defstruct checked-grid
  :spec grid-spec
  :layouts (vec layout)
  :warnings (vec grid-warning))

(type check-grid
  (fn (grid-spec) (result checked-grid grid-error)))

(defn check-grid (spec)
  (if (empty? (:type-areas spec))
    (err grid-error/no-type-area)
    (let (all (layouts (ref spec)))
      (try (check-font-weights (ref spec)))
      (try (check-square (:body-type spec)))
      (try (check-layouts (ref all) 0))
      (try (check-measure (ref spec) (ref all)))
      (try (check-type-styles (ref spec) 0))
      (let (warnings (measure-warnings (ref spec) (ref all)))
        (ok (->checked-grid spec all warnings))))))

(type check-layouts
  (fn ((ref (vec layout)) usize)
    (result unit grid-error)))

(defn check-layouts (all index)
  (if (>= index (len all))
    (ok (do))
    (do
      (try (check-layout all index))
      (recur all (+ index 1)))))

(type check-layout
  (fn ((ref (vec layout)) usize)
    (result unit grid-error)))

(defn check-layout (all index)
  (let (layout (at all index)
        type-area (:type-area layout))
    (cond
      ((not (fits? type-area))
       (err (grid-error/type-area-does-not-fit (layout-label layout)
                                               (clone type-area)
                                               (fitting-column-counts
                                                 type-area))))
      ((name-taken? all index)
       (err (grid-error/type-area-name-repeated (clone (:name type-area)))))
      ((out-of-order? all index)
       (let (previous (at all (- index 1)))
         (err (grid-error/type-areas-out-of-order (clone (:name type-area))
                                                  (:min-width-em layout)
                                                  (clone (:name (:type-area
                                                                  previous)))
                                                  (:min-width-em previous)))))
      (else (do
              (try (check-page-margins type-area))
              (check-fields layout))))))

(type name-taken?
  (fn ((ref (vec layout)) usize) bool))

(defn name-taken? (all index)
  (let (name (:name (:type-area (at all index))))
    (any? (take (iter all) index)
      (fn (earlier)
        (= (:name (:type-area earlier)) name)))))

(type out-of-order?
  (fn ((ref (vec layout)) usize) bool))

(defn out-of-order? (all index)
  (and (>= index 2)
       (<= (:min-width-em (at all index))
           (:min-width-em (at all (- index 1))))))
