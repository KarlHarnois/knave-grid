(use check/problems grid-error grid-warning
                    narrowest-measure-ch widest-measure-ch)

(use browser default-font-size-px)
(use check/page-margins check-page-margins)
(use check/type-styles check-type-styles)
(use spec/body-type body-type ch-px)
(use spec/grid-spec breakpoint grid-spec)
(use spec/type-area fits? fitting-column-counts type-area)

(export ->checked-grid check-grid checked-grid grid-error
        grid-warning)

(def margin-count 2)

(def float-of
  (rust "{0} as f64" (fn (i64) f64)))

(defstruct checked-grid
  :spec grid-spec
  :warnings (vec grid-warning))

(type check-grid
  (fn (grid-spec) (result checked-grid grid-error)))

(defn check-grid (spec)
  (let (type-area (:type-area spec))
    (if (fits? type-area)
      (do
        (try (check-breakpoints (ref spec) 0 0.0))
        (try (check-measure (ref spec)))
        (try (check-type-styles (ref spec) 0))
        (try (check-page-margins (ref spec)))
        (let (warnings (measure-warnings (:measure-ch spec)))
          (ok (->checked-grid spec warnings))))
      (err (grid-error/type-area-does-not-fit (deref type-area)
                                              (fitting-column-counts
                                                type-area))))))

(type check-breakpoints
  (fn ((ref grid-spec) usize f64)
    (result unit grid-error)))

(defn check-breakpoints (spec index previous-em)
  (if (>= index (len (:breakpoints spec)))
    (ok (do))
    (let (breakpoint (at (:breakpoints spec) index))
      (try (check-breakpoint (ref (:body-type spec))
                             breakpoint previous-em))
      (recur spec (+ index 1) (:min-width-em breakpoint)))))

(type check-breakpoint
  (fn ((ref body-type) (ref breakpoint) f64)
    (result unit grid-error)))

(defn check-breakpoint (type breakpoint previous-em)
  (let (min-width-em (:min-width-em breakpoint)
        type-area (:type-area breakpoint)
        needed-em (needed-em type type-area))
    (cond
      ((<= min-width-em previous-em)
       (err (grid-error/breakpoint-out-of-order min-width-em
                                                previous-em)))
      ((not (fits? type-area))
       (err (grid-error/breakpoint-does-not-fit min-width-em
                                                (deref type-area)
                                                (fitting-column-counts
                                                  type-area))))
      ((> needed-em min-width-em)
       (err (grid-error/breakpoint-too-narrow min-width-em
                                              (:width-ch type-area)
                                              (:margin-ch type-area)
                                              needed-em)))
      (else (ok (do))))))

(type needed-em
  (fn ((ref body-type) (ref type-area))
    f64))

(defn needed-em (type type-area)
  (let (width-with-margins-ch (+ (:width-ch type-area)
                                 (* margin-count (:margin-ch type-area))))
    (/ (* (float-of width-with-margins-ch) (ch-px type))
       default-font-size-px)))

(type check-measure
  (fn ((ref grid-spec))
    (result unit grid-error)))

(defn check-measure (spec)
  (let (measure-ch (:measure-ch spec)
        widest-ch (widest-type-area-ch spec))
    (if (> measure-ch widest-ch)
      (err (grid-error/measure-wider-than-type-area measure-ch
                                                    widest-ch))
      (ok (do)))))

(type widest-type-area-ch
  (fn ((ref grid-spec)) i64))

(defn widest-type-area-ch (spec)
  (reduce (map (iter (:breakpoints spec))
            (fn (breakpoint)
              (:width-ch (:type-area breakpoint))))
          (:width-ch (:type-area spec))
          (fn (widest width)
            (if (> width widest) width widest))))

(defn measure-warnings (measure-ch)
  (if (readable-measure? measure-ch)
    (vec)
    (vec (grid-warning/measure-out-of-range measure-ch))))

(defn readable-measure? (measure-ch)
  (and (>= measure-ch narrowest-measure-ch)
       (<= measure-ch widest-measure-ch)))
