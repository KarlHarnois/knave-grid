(use check/problems grid-error)
(use spec/body-type body-type)
(use spec/grid-spec grid-spec)
(use spec/line-box glyph-height-px)

(use spec/type-style style-baseline-line style-font-size-px
                     style-line-height-px style-metrics
                     type-style)

(export check-type-styles)

(type check-type-styles
  (fn ((ref grid-spec) usize)
    (result unit grid-error)))

(defn check-type-styles (spec index)
  (if (>= index (len (:type-styles spec)))
    (ok (do))
    (do
      (try (check-type-style (at (:type-styles spec) index)
                             (:body-type spec)))
      (recur spec (+ index 1)))))

(type check-type-style
  (fn ((ref type-style) (ref body-type))
    (result unit grid-error)))

(defn check-type-style (style body)
  (let (lines (:lines style)
        baseline-line (style-baseline-line style body))
    (cond
      ((< lines 1)
       (err (grid-error/type-style-without-lines (clone (:name style)))))
      (else (do
              (try (check-type-style-size style body))
              (check-baseline-line style baseline-line lines))))))

(type check-baseline-line
  (fn ((ref type-style) i64 i64)
    (result unit grid-error)))

(defn check-baseline-line (style baseline-line lines)
  (if (or (< baseline-line 1) (> baseline-line lines))
    (err (grid-error/baseline-line-outside-style (clone (:name style))
                                                 baseline-line
                                                 lines))
    (ok (do))))

(type check-type-style-size
  (fn ((ref type-style) (ref body-type))
    (result unit grid-error)))

(defn check-type-style-size (style body)
  (let (font-size-px (style-font-size-px style body)
        glyph-height (glyph-height-px (ref (style-metrics style body))
                                      font-size-px)
        line-height (style-line-height-px style body))
    (if (> glyph-height line-height)
      (err (grid-error/type-style-too-big
             (clone (:name style))
             font-size-px glyph-height line-height))
      (ok (do)))))
