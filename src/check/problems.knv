(use font/tables font-error)
(use font/weight weight-names)
(use spec/type-area type-area)

(export column-count-text grid-error squares)

(defenum grid-error
  (no-type-area)
  (body-font-without-zero :family string)
  (unusable-font :error font-error)
  (unknown-font-weight :owner string :weight string)
  (missing-font-weight :owner string
                       :family string
                       :weight string)
  (type-area-does-not-fit :layout string
                          :type-area type-area
                          :fitting-counts (vec i64))
  (type-area-name-repeated :name string)
  (type-areas-out-of-order :name string
                           :min-width-em f64
                           :previous-name string
                           :previous-em f64)
  (measure-columns-outside :layout string
                           :columns i64
                           :column-count i64)
  (square-not-whole-characters :square-px f64 :ch-px f64)
  (type-style-without-lines :name string)
  (page-margin-too-small :edge string :squares i64)
  (fields-too-small :layout string :lines i64 :gap i64)
  (capitals-taller-than-style :name string
                              :needed-lines i64
                              :lines i64)
  (baseline-line-outside-style :name string
                               :baseline-line i64
                               :lines i64)
  (type-style-too-big :name string
                      :font-size-px f64
                      :glyph-height-px f64
                      :line-height-px f64)
  (unwritable :path string :reason string))

(display grid-error (error)
  (match error
    (no-type-area (str "a grid spec needs at least one type area"))
    ((body-font-without-zero family)
     (str "the body font " family
          " has no glyph for 0, so the grid cannot measure its characters; give the body a full font file"))
    ((unusable-font error) (str error))
    ((unknown-font-weight owner weight)
     (str owner " sets the weight " weight
          ", but font weights are " weight-names))
    ((missing-font-weight owner family weight)
     (str owner " uses " family " at weight " weight
          ", but the family has no " weight " file"))
    ((type-area-does-not-fit layout type-area fitting-counts)
     (str "in " layout ", "
          (fit-message type-area fitting-counts)))
    ((type-area-name-repeated name)
     (str "two type areas are named " name
          "; give each its own name"))
    ((type-areas-out-of-order name min-width-em
                              previous-name previous-em)
     (str "the " name " type area needs " min-width-em
          "em, no more than the " previous-name
          " type area before it, which needs " previous-em
          "em; list type areas from narrowest to widest"))
    ((measure-columns-outside layout columns column-count)
     (str "in " layout ", the measure spans "
          (column-count-text (deref columns))
          ", but the type area has columns 1 to "
          column-count))
    ((square-not-whole-characters square-px ch-px)
     (str "the body font is monospace, but a square of "
          square-px "px is "
          (/ square-px ch-px)
          " characters of " ch-px
          "px; choose a line-height that makes it a whole number"))
    ((type-style-without-lines name)
     (str "the type style " name " needs at least one line"))
    ((fields-too-small layout lines gap)
     (str "in " layout ", fields are "
          (line-count-text (deref lines))
          " with "
          (line-count-text (deref gap))
          " between them, but a field needs at least one line and a gap cannot be negative"))
    ((page-margin-too-small edge squares-count)
     (str
       "the " edge " margin is "
       (squares (deref squares-count))
       ", but a page edge needs at least one square to its nearest baseline"))
    ((capitals-taller-than-style name needed-lines lines)
     (str "the capitals of the type style " name " need "
          (line-count-text (deref needed-lines))
          " to hang from the top of its block, but it has "
          (line-count-text (deref lines))))
    ((baseline-line-outside-style name baseline-line lines)
     (str "the type style " name
          " puts its baseline on line " baseline-line
          ", but it has lines 1 to " lines))
    ((type-style-too-big name font-size-px glyph-height-px
                         line-height-px)
     (str "the type style " name " sets " font-size-px
          "px type, whose glyphs are " glyph-height-px
          "px tall, in " line-height-px "px of lines"))
    ((unwritable path reason)
     (str "cannot write " path ": " reason))))

(defn line-count-text (count)
  (if (= count 1)
    (str "1 line")
    (str count " lines")))

(defn column-count-text (count)
  (if (= count 1)
    (str "1 column")
    (str count " columns")))

(defn squares (count)
  (if (= count 1)
    (str "1 square")
    (str count " squares")))

(type fit-message
  (fn ((ref type-area) (ref (vec i64)))
    string))

(defn fit-message (type-area fitting-counts)
  (str (squares (:width type-area))
       " with a gutter of "
       (squares (:gutter type-area))
       " do not fit "
       (:column-count type-area)
       " columns; the column counts that fit are "
       (joined-counts fitting-counts)))

(def joined-counts
  (rust "{0}.iter().map(|count| count.to_string()).collect::<Vec<_>>().join(\", \")"
    (fn ((ref (vec i64))) string)))
